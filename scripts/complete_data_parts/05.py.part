plan["lastVerified"] = max(plan.get("lastVerified", AS_OF), AS_OF)

# ---------------------------------------------------------------------------
# Model registry and route-level access semantics
# ---------------------------------------------------------------------------
model_benchmarks = [b for b in benchmarks if b.get("kind") == "model-intelligence"]
agent_benchmarks = [b for b in benchmarks if b.get("benchmark") == "Artificial Analysis Coding Agent Index"]
benchmark_by_id = {b["id"]: b for b in benchmarks}

