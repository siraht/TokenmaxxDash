        included_value_usd=q(base_value+max_daily_value), formula="credit value = credits × plan-specific credit price; daily grants count only when claimed",
        quotas={"monthlyPurchasedCredits": monthly, "maximumMonthlyDailyGrantCredits": 150, "usdPerCredit": per_credit},
        models=["Lovable managed app agent"], notes=["The upper bound assumes all available daily grants are claimed; it is not guaranteed realized value."],
        unit="Lovable build credit", plan_units=monthly + 150,
    ))
plans.append(make_plan(
    "Lovable", "Free", 0, provider_id="lovable", calculation_status="exact", confidence="high", allowance_type="daily build credits",
    headline="5 daily build credits, capped at 30 per month.", sources_=["lovable-pricing"], formula="daily credits stop once the monthly cap is reached",
    quotas={"dailyCredits": 5, "monthlyCapCredits": 30}, models=["Lovable managed app agent"], unit="Lovable build credit", plan_units=30,
))
for name, price, monthly, daily_login in [("Free", 0, 5, 0), ("Plus", 30, 30, 2), ("Business", 100, 30, 2)]:
    low = Decimal(monthly)
    high = low + Decimal(daily_login * 30)
    plans.append(make_plan(
        "v0", name, price, provider_id="v0", calculation_status="exact", confidence="high",
        allowance_type="platform credits plus conditional login grants", headline=f"${monthly} recurring monthly credits" + (f" plus up to ${daily_login}/day login grants (${q(high)} maximum in a 30-day month)." if daily_login else "."),
        sources_=["v0-pricing"],
        value_multiple_low=(q(low/Decimal(str(price)), "0.001") if price else None), value_multiple_high=(q(high/Decimal(str(price)), "0.001") if price else None),
        included_value_usd=q(high), formula="maximum value = monthly credits + daily login grant × days claimed",
        quotas={"monthlyCreditsUsd": monthly, "dailyLoginGrantUsd": daily_login, "thirtyDayMaximumUsd": q(high)}, models=["v0 managed app agent"],
        notes=["Daily login credits are conditional and should not be treated as guaranteed unless claimed."], unit="v0 credit USD", plan_units=q(high),
    ))

