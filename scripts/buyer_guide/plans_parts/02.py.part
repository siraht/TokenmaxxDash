        windows=f"${h5}/5h · ${week}/week · up to ${pool}/month",
        source=f"https://commandcode.ai/docs/plans/{'max' if name.startswith('Max') else name.lower()}",
        policy="API-compatible" if name != "Go" else "interactive coding",
        note=tier_note,
    )
