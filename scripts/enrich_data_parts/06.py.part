benchmarks = [b for b in benchmarks if b.get("kind") != "model-intelligence"] + model_rows

# Derived economics for externally published benchmark rows.
for row in benchmarks:
    score = row.get("score")
    if not isinstance(score, (int, float)) or score <= 0:
        continue
    if row.get("kind") == "coding-agent" and row.get("benchmark") == "Artificial Analysis Coding Agent Index":
        cost = row.get("apiCostPerTaskUsd")
        if isinstance(cost, (int, float)) and cost > 0:
            pass_rate = score / 100
            row["expectedPassesPerApiDollar"] = round(pass_rate / cost, 6)
            row["apiUsdPerExpectedPass"] = round(cost / pass_rate, 6)
            row["scorePointsPerApiDollar"] = round(score / cost, 6)
        if isinstance(row.get("timePerTaskMinutes"), (int, float)):
            row["minutesPerExpectedPass"] = round(row["timePerTaskMinutes"] / (score / 100), 6)
    if row.get("kind") == "model-intelligence":
        blended = row.get("blendedPricePerMUsd")
        if isinstance(blended, (int, float)) and blended > 0:
            row["intelligencePointsPerBlendedDollar"] = round(score / blended, 6)
            row["blendedUsdPerIntelligencePoint"] = round(blended / score, 8)
        speed = row.get("outputTokensPerSecond")
        if isinstance(speed, (int, float)):
            row["intelligenceSpeedProduct"] = round(score * speed, 3)


def mark_pareto(rows: list[dict[str, Any]], *, score_key: str, cost_key: str, flag: str, minimize_cost: bool = True) -> None:
    valid = [r for r in rows if isinstance(r.get(score_key), (int, float)) and isinstance(r.get(cost_key), (int, float))]
    for row in rows:
        row[flag] = False
    for row in valid:
        dominated = False
        for other in valid:
            if other is row:
                continue
            score_better = other[score_key] >= row[score_key]
            cost_better = other[cost_key] <= row[cost_key] if minimize_cost else other[cost_key] >= row[cost_key]
            strict = other[score_key] > row[score_key] or (other[cost_key] < row[cost_key] if minimize_cost else other[cost_key] > row[cost_key])
            if score_better and cost_better and strict:
                dominated = True
                break
        row[flag] = not dominated

agent_index_rows = [b for b in benchmarks if b.get("benchmark") == "Artificial Analysis Coding Agent Index"]
mark_pareto(agent_index_rows, score_key="score", cost_key="apiCostPerTaskUsd", flag="costQualityPareto")
mark_pareto(agent_index_rows, score_key="score", cost_key="timePerTaskMinutes", flag="timeQualityPareto")
mark_pareto(agent_index_rows, score_key="score", cost_key="tokensPerTaskM", flag="tokenQualityPareto")
mark_pareto(model_rows, score_key="score", cost_key="blendedPricePerMUsd", flag="priceIntelligencePareto")
mark_pareto(model_rows, score_key="score", cost_key="outputTokensPerSecond", flag="speedIntelligencePareto", minimize_cost=False)

# Canonical model catalog and benchmark coverage for every advertised route.
def slug(value: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")


def canonicalize(value: str) -> str:
    value = value.strip()
    value = re.sub(r"\s+off-peak$", "", value, flags=re.I)
    value = re.sub(r"\s+\(promo\)$", "", value, flags=re.I)
    substitutions = {
        "Claude Opus 5": "Claude Opus 5",
        "Opus 5": "Claude Opus 5",
        "Claude Fable 5": "Claude Fable 5",
        "Fable 5": "Claude Fable 5",
        "Gemma 31B": "Gemma 4 31B",
        "HY3": "Hy3",
        "GPT-5.6 Sol": "GPT-5.6 Sol",
        "GPT-5.6 Terra": "GPT-5.6 Terra",
        "GPT-5.6 Luna": "GPT-5.6 Luna",
    }
    return substitutions.get(value, value)


def base_benchmark_model(value: str) -> str:
    value = canonicalize(value)
    value = re.sub(r"\s*\((max|xhigh|high|medium|low|minimal|none|fallback)[^)]*\)$", "", value, flags=re.I)
    if value.startswith("Claude "):
        return value
    if value.startswith("Opus "):
        return "Claude " + value
    if value.startswith("Fable "):
        return "Claude " + value
    return value

