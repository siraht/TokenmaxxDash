# StepFun publishes the clearest high-subsidy monthly pool in the current market.
stepfun_models = ["Step 3.7 Flash", "Step 3.5 Flash", "Step 3.5 Flash 2603", "Step Router V1"]
for name, price, credits_m, quarterly, yearly in [
    ("Flash Mini", 6.99, 400, 18.99, 69.99),
    ("Flash Plus", 9.99, 1600, 26.99, 95.99),
    ("Flash Pro", 29, 8000, 79, 289),
    ("Flash Max", 99, 40000, 269, 989),
]:
    credits = Decimal(credits_m) * Decimal("1000000")
    approx_value = credits / Decimal("7000000")
    monthly_multiple = approx_value / Decimal(str(price))
    quarterly_effective_monthly = Decimal(str(quarterly)) / Decimal("3")
    yearly_effective_monthly = Decimal(str(yearly)) / Decimal("12")
    quarterly_multiple = approx_value / quarterly_effective_monthly
    yearly_multiple = approx_value / yearly_effective_monthly
    plans.append(make_plan(
        "StepFun Step Plan", name, price, provider_id="stepfun", calculation_status="derived", confidence="high",
        allowance_type="monthly unified model-usage credits",
        headline=f"{credits_m:,}M credits/month ≈ ${q(approx_value):,.2f} of StepFun model usage; no five-hour or RPM/TPM plan bucket.",
        sources_=["stepfun-plan"], value_multiple=q(monthly_multiple, "0.001"),
        included_value_usd=q(approx_value),
        formula="approximate model-usage value = monthly credits / 7,000,000; requests consume model-specific credits",
        quotas={
            "monthlyCredits": int(credits), "monthlyCreditsMillions": credits_m,
            "quarterlyPriceUsd": quarterly,
            "quarterlyEffectiveMonthlyUsd": q(quarterly_effective_monthly),
            "quarterlyValueMultiple": q(quarterly_multiple, "0.001"),
            "yearlyPriceUsd": yearly,
            "yearlyEffectiveMonthlyUsd": q(yearly_effective_monthly),
            "yearlyValueMultiple": q(yearly_multiple, "0.001"),
            "rollingWindow": None, "rollover": False,
        },
        models=stepfun_models,
        notes=[
            "The official conversion is approximate ($1 ≈ 7M credits), so the value multiple is a transparent nominal estimate rather than exact invoiced dollars.",
            "All tiers receive the same model speed; credits clear at month end and booster packs expire separately after 30 days.",
            "The primary ranking uses the month-to-month price so plans with different commitment periods remain comparable; the quarterly and yearly effective prices and multiples are retained on the plan page.",
            f"At the published yearly price, the effective nominal multiple is approximately {q(yearly_multiple, '0.001'):g}×.",
            "This value is StepFun-rate replacement value and is not quality-adjusted against frontier proprietary models.",
        ],
        unit="StepFun credit", plan_units=int(credits),
        details={
            "approxCreditsPerProviderUsd": 7000000,
            "billingTermValueMultiples": [
                {"term": "monthly", "effectiveMonthlyUsd": price, "valueMultiple": q(monthly_multiple, "0.001")},
                {"term": "quarterly", "effectiveMonthlyUsd": q(quarterly_effective_monthly), "valueMultiple": q(quarterly_multiple, "0.001")},
