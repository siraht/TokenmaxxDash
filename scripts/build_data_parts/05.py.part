# ---- MiMo exact credit pools and exact PAYG mapping ----
mimo_models = [
    {"model": "MiMo V2.5", "cacheCreditsPerToken": 2, "inputCreditsPerToken": 100, "outputCreditsPerToken": 200, "cacheUsdPerM": 0.0028, "inputUsdPerM": 0.14, "outputUsdPerM": 0.28},
    {"model": "MiMo V2.5 Pro", "cacheCreditsPerToken": 2.5, "inputCreditsPerToken": 300, "outputCreditsPerToken": 600, "cacheUsdPerM": 0.0036, "inputUsdPerM": 0.435, "outputUsdPerM": 0.87},
]
for name, price, credits_b in [("Lite", 6, 4.1), ("Standard", 16, 11), ("Pro", 50, 38), ("Max", 100, 82)]:
    credits = Decimal(str(credits_b)) * Decimal("1000000000")
    category_values = []
    pure = []
    for model in mimo_models:
        input_tokens = credits / Decimal(str(model["inputCreditsPerToken"]))
        cache_tokens = credits / Decimal(str(model["cacheCreditsPerToken"]))
        output_tokens = credits / Decimal(str(model["outputCreditsPerToken"]))
        input_value = input_tokens / Decimal("1000000") * Decimal(str(model["inputUsdPerM"]))
        cache_value = cache_tokens / Decimal("1000000") * Decimal(str(model["cacheUsdPerM"]))
        output_value = output_tokens / Decimal("1000000") * Decimal(str(model["outputUsdPerM"]))
        category_values.extend([input_value, cache_value, output_value])
        pure.append({
            "model": model["model"],
            "pureInputM": q(input_tokens / Decimal("1000000")),
            "pureCachedM": q(cache_tokens / Decimal("1000000")),
            "pureOutputM": q(output_tokens / Decimal("1000000")),
            "apiValueInputUsd": q(input_value),
            "apiValueCacheUsd": q(cache_value),
            "apiValueOutputUsd": q(output_value),
        })
    low = min(category_values)
    high = max(category_values)
    plans.append(make_plan(
        "Xiaomi MiMo Token Plan", name, price, provider_id="xiaomi-mimo", calculation_status="exact", confidence="high",
        allowance_type="token credits", headline=f"{credits_b:g}B credits/month; roughly ${q(low)}–${q(high)} of matching PAYG value by token category.",
        sources_=["mimo-token-plan", "mimo-api-pricing"],
        value_multiple_low=q(low/Decimal(price), "0.001"), value_multiple_high=q(high/Decimal(price), "0.001"),
        included_value_usd=q(high),
        formula="credits = cache_tokens×cache_rate + uncached_input×input_rate + output×output_rate",
        quotas={"monthlyCredits": int(credits), "monthlyCreditsBillions": credits_b},
        models=[m["model"] for m in mimo_models],
