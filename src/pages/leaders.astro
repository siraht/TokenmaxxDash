---
import BaseLayout from '../layouts/BaseLayout.astro';
import benchmarks from '../data/benchmarks.json';
import leaders from '../data/leaders.json';
import plans from '../data/plans.json';
import qualityRoutes from '../data/quality-routes.json';
import taskEstimates from '../data/subscription-task-estimates.json';
import { formatNumber, statusLabel } from '../lib/format';

const benchmarkById = new Map(benchmarks.map((row) => [row.id, row]));
const taskById = new Map(taskEstimates.map((row) => [row.id, row]));
const routeById = new Map(qualityRoutes.map((row) => [row.id, row]));
const planById = new Map(plans.map((row) => [row.id, row]));

const taskRows = (ids = []) => ids.map((id) => taskById.get(id)).filter(Boolean);
const benchmarkRows = (ids = []) => ids.map((id) => benchmarkById.get(id)).filter(Boolean);
const routeRows = (ids = []) => ids.map((id) => routeById.get(id)).filter(Boolean);

const budgetFront = taskRows(leaders.subscriptionTaskBudgetParetoByQualityFloor?.frontier)
  .sort((a, b) => a.priceMonthly - b.priceMonthly || b.score - a.score || a.subscriptionUsdPerExpectedPassHigh - b.subscriptionUsdPerExpectedPassHigh);
const throughputFront = taskRows(leaders.subscriptionTaskParetoByQualityFloor?.frontier)
  .sort((a, b) => b.expectedBenchmarkPassesPerAverageMonthLow - a.expectedBenchmarkPassesPerAverageMonthLow || b.score - a.score);
const providerFronts = Object.entries(leaders.subscriptionTaskProviderParetoByQualityFloor?.frontier || {}).map(([provider, ids]) => ({
  provider,
  rows: taskRows(ids).sort((a, b) => b.score - a.score || a.evidenceAdjustedSubscriptionUsdPerExpectedPassHigh - b.evidenceAdjustedSubscriptionUsdPerExpectedPassHigh).slice(0, 6)
}));
const costQuality = benchmarkRows(leaders.codingAgentCostQualityPareto).sort((a, b) => b.score - a.score);
const modelPrice = benchmarkRows(leaders.modelPriceIntelligencePareto).sort((a, b) => b.score - a.score);
const modelSpeed = benchmarkRows(leaders.modelSpeedIntelligencePareto).sort((a, b) => b.score - a.score);
const evidenceCapacity = routeRows(leaders.evidenceAdjustedCapacityParetoByMinIntelligence?.['60'])
  .sort((a, b) => b.modelIntelligenceIndex - a.modelIntelligenceIndex || b.evidenceAdjustedQualityCapacity - a.evidenceAdjustedQualityCapacity);
const accessPrice = routeRows(leaders.planAccessPriceIntelligencePareto).sort((a, b) => b.modelIntelligenceIndex - a.modelIntelligenceIndex || a.priceMonthly - b.priceMonthly);
const rawLeaders = (leaders.rawSubsidyLeaders || []).map((id) => planById.get(id)).filter(Boolean).slice(0, 12);
const fableTasks = taskEstimates.filter((row) => row.model === 'Claude Fable 5').sort((a, b) => a.priceMonthly - b.priceMonthly);
const fableAgent = benchmarkById.get('aa-agent-claude-code-fable-5-max-fallback');
const fableModel = benchmarkById.get('aa-model-claude-fable-5-max');
---
<BaseLayout title="Pareto leaders" description="Quality-gated Pareto frontiers for coding subscriptions, external native-agent task economics, model intelligence, latency, and evidence-adjusted allowance.">
  <section class="page-intro">
    <p class="eyebrow">No master score</p>
    <h1>Choose the frontier that matches the constraint you actually have.</h1>
    <p class="lede">The default subscription fronts require an external score of at least 60. Price, sustainable task throughput, cost per accepted benchmark-equivalent pass, model intelligence, latency, and evidence confidence remain separate axes.</p>
  </section>

  <section class="section compact">
    <div class="metric-ribbon">
      <div><strong>≥60</strong><span>default model-quality floor</span></div>
      <div><strong>range-first</strong><span>hidden pools use lower and upper bounds</span></div>
      <div><strong>native joins</strong><span>agent + model + plan route must match</span></div>
      <div><strong>raw last</strong><span>token subsidy never becomes intelligence</span></div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div><p class="section-kicker">Budget frontier · quality ≥60</p><h2>Cheapest non-dominated access to externally measured coding performance</h2></div>
      <p>This front preserves lower-priced tiers even when a larger tier has better unit economics. A row survives only when no alternative is at least as capable, no more expensive monthly, and no worse on conservative cost per expected pass.</p>
    </div>
    <div class="panel"><div class="table-shell"><table>
      <thead><tr><th>Plan / route</th><th>Index</th><th>Price</th><th>Expected passes/month</th><th>Subscription $/expected pass</th><th>Confidence-adjusted worst case</th></tr></thead>
      <tbody>{budgetFront.map((row) => (
        <tr>
          <td><a href={`/plans/${row.planId}`}><strong>{row.provider} · {row.plan}</strong></a><span class="cell-sub">{row.benchmarkModel}</span></td>
          <td class="numeric"><strong>{row.score}</strong></td>
          <td class="numeric">${row.priceMonthly}/mo</td>
          <td class="numeric">{formatNumber(row.expectedBenchmarkPassesPerAverageMonthLow)}–{formatNumber(row.expectedBenchmarkPassesPerAverageMonthHigh)}</td>
          <td class="numeric">${row.subscriptionUsdPerExpectedPassLow.toFixed(3)}–${row.subscriptionUsdPerExpectedPassHigh.toFixed(3)}</td>
          <td class="numeric"><strong>${row.evidenceAdjustedSubscriptionUsdPerExpectedPassHigh.toFixed(3)}</strong><span class="cell-sub">{row.evidenceConfidence} allowance confidence</span></td>
        </tr>
      ))}</tbody>
    </table></div></div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div><p class="section-kicker">Throughput frontier · quality ≥60</p><h2>Highest conservative passing-work capacity</h2></div>
      <p>This front favors sustained output and unit economics. A $200 tier can dominate its smaller sibling here, so the budget frontier above remains a separate decision surface.</p>
    </div>
    <div class="panel"><div class="table-shell"><table>
      <thead><tr><th>Plan / route</th><th>Index</th><th>Conservative expected passes/month</th><th>High estimate</th><th>Conservative $/pass</th><th>Evidence-adjusted passes</th></tr></thead>
      <tbody>{throughputFront.map((row) => (
        <tr>
          <td><a href={`/plans/${row.planId}`}><strong>{row.provider} · {row.plan}</strong></a><span class="cell-sub">{row.benchmarkModel}</span></td>
          <td class="numeric">{row.score}</td>
          <td class="numeric"><strong>{formatNumber(row.expectedBenchmarkPassesPerAverageMonthLow)}</strong></td>
          <td class="numeric">{formatNumber(row.expectedBenchmarkPassesPerAverageMonthHigh)}</td>
          <td class="numeric">${row.subscriptionUsdPerExpectedPassHigh.toFixed(3)}</td>
          <td class="numeric">{formatNumber(row.evidenceAdjustedExpectedPassesPerAverageMonthLow)}</td>
        </tr>
      ))}</tbody>
    </table></div></div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div><p class="section-kicker">Product-specific fronts</p><h2>Compare each native coding product without letting one vendor erase the rest.</h2></div>
      <p>These are Pareto fronts calculated inside each product family at the same quality floor. They expose the best observed configurations available within Claude Code and Codex even when one is globally dominated on a particular axis.</p>
    </div>
    <div class="frontier-grid">{providerFronts.map(({ provider, rows }) => (
      <article class="panel">
        <div class="panel-header"><div><h3>{provider}</h3><p>{rows.length} non-dominated native configurations at score ≥60</p></div></div>
        <div class="table-shell"><table>
          <thead><tr><th>Plan / model</th><th>Index</th><th>$/pass range</th></tr></thead>
          <tbody>{rows.map((row) => (
            <tr><td><a href={`/plans/${row.planId}`}><strong>{row.plan}</strong></a><span class="cell-sub">{row.benchmarkModel}</span></td><td class="numeric">{row.score}</td><td class="numeric">${row.subscriptionUsdPerExpectedPassLow.toFixed(3)}–${row.subscriptionUsdPerExpectedPassHigh.toFixed(3)}</td></tr>
          ))}</tbody>
        </table></div>
      </article>
    ))}</div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div><p class="section-kicker">Fable 5 profile</p><h2>Visible even when another Claude configuration dominates it.</h2></div>
      <p>Pareto membership is not a visibility filter. Fable’s direct benchmark evidence and Max-only allowance constraints remain first-class because users may value its speed, behavior, or model specialization.</p>
    </div>
    <div class="panel">
      <div class="panel-body fable-summary">
        <div><span>Model intelligence</span><strong>{fableModel?.score ?? '—'}</strong><small>${fableModel?.blendedPricePerMUsd?.toFixed(2)}/M external 7:2:1 blend</small></div>
        <div><span>Claude Code index</span><strong>{fableAgent?.score ?? '—'}</strong><small>${fableAgent?.apiCostPerTaskUsd?.toFixed(2)} API cost/task</small></div>
        <div><span>Max weekly ceiling</span><strong>50%</strong><small>shared-meter share; hidden Fable multiplier</small></div>
      </div>
      <div class="table-shell"><table>
        <thead><tr><th>Plan</th><th>Access</th><th>Index</th><th>Expected passes/month</th><th>Subscription $/expected pass</th></tr></thead>
        <tbody>{fableTasks.map((row) => (
          <tr><td><a href={`/plans/${row.planId}`}><strong>{row.provider} · {row.plan}</strong></a></td><td>Included, capped at 50% of shared weekly meter</td><td class="numeric">{row.score}</td><td class="numeric">{formatNumber(row.expectedBenchmarkPassesPerAverageMonthLow)}–{formatNumber(row.expectedBenchmarkPassesPerAverageMonthHigh)}</td><td class="numeric">${row.subscriptionUsdPerExpectedPassLow.toFixed(3)}–${row.subscriptionUsdPerExpectedPassHigh.toFixed(3)}</td></tr>
        ))}</tbody>
      </table></div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading"><div><p class="section-kicker">External task economics</p><h2>Coding quality versus API cost per expected pass</h2></div><p>This front ignores subscriptions and uses the benchmark publisher’s provider-priced task cost. It captures harness efficiency and model quality together.</p></div>
    <div class="panel"><div class="table-shell"><table><thead><tr><th>Configuration</th><th>Index</th><th>API cost/task</th><th>API $/expected pass</th><th>Time/task</th><th>Tokens/expected pass</th></tr></thead><tbody>{costQuality.map((row) => (
      <tr><td><strong>{row.agent}</strong><span class="cell-sub">{row.model}</span></td><td class="numeric">{row.score}</td><td class="numeric">${row.apiCostPerTaskUsd?.toFixed(2)}</td><td class="numeric"><strong>${row.apiUsdPerExpectedPass?.toFixed(3)}</strong></td><td class="numeric">{row.timePerTaskMinutes?.toFixed(1)}m</td><td class="numeric">{row.tokensPerExpectedPassM?.toFixed(2)}M</td></tr>
    ))}</tbody></table></div></div>
  </section>

  <section class="section">
    <div class="section-heading"><div><p class="section-kicker">Model economics</p><h2>Intelligence versus normalized token price</h2></div><p>The 7:2:1 blend is 70% cache reads, 20% fresh input, and 10% output. Dollars per intelligence point is a density measure, not a task pass probability.</p></div>
    <div class="frontier-grid">
      <article class="panel"><div class="panel-header"><div><h3>Price–intelligence frontier</h3><p>Lower normalized token cost, higher intelligence</p></div></div><div class="table-shell"><table><thead><tr><th>Model</th><th>Intelligence</th><th>Blend/M</th><th>$/point</th></tr></thead><tbody>{modelPrice.map((row) => <tr><td><strong>{row.model}</strong><span class="cell-sub">{row.provider}</span></td><td class="numeric">{row.score}</td><td class="numeric">${row.blendedPricePerMUsd?.toFixed(3)}</td><td class="numeric">${row.blendedUsdPerIntelligencePoint?.toFixed(5)}</td></tr>)}</tbody></table></div></article>
      <article class="panel"><div class="panel-header"><div><h3>Speed–intelligence frontier</h3><p>Higher output speed, higher intelligence</p></div></div><div class="table-shell"><table><thead><tr><th>Model</th><th>Intelligence</th><th>Output speed</th><th>Blend/M</th></tr></thead><tbody>{modelSpeed.map((row) => <tr><td><strong>{row.model}</strong><span class="cell-sub">{row.provider}</span></td><td class="numeric">{row.score}</td><td class="numeric">{row.outputTokensPerSecond?.toFixed(1)} t/s</td><td class="numeric">{row.blendedPricePerMUsd != null ? `$${row.blendedPricePerMUsd.toFixed(3)}` : '—'}</td></tr>)}</tbody></table></div></article>
    </div>
  </section>

  <section class="section">
    <div class="section-heading"><div><p class="section-kicker">Plan/model capacity · intelligence ≥60</p><h2>Evidence-adjusted allowance without a raw-token master score</h2></div><p>The signal multiplies conservative allowance by normalized intelligence and an evidence-confidence factor. It remains a heuristic secondary view, never a replacement for the native task front above.</p></div>
    <div class="panel"><div class="table-shell"><table><thead><tr><th>Plan / model</th><th>Price</th><th>Intelligence</th><th>Conservative allowance multiple</th><th>Evidence-adjusted quality capacity</th><th>Evidence</th></tr></thead><tbody>{evidenceCapacity.map((row) => (
      <tr><td><a href={`/plans/${row.planId}`}><strong>{row.provider} · {row.plan}</strong></a><span class="cell-sub">{row.model}</span></td><td class="numeric">${row.priceMonthly}/mo</td><td class="numeric">{row.modelIntelligenceIndex}</td><td class="numeric">{row.planValueMultipleLowerBound?.toFixed(3)}×</td><td class="numeric"><strong>{row.evidenceAdjustedQualityCapacity?.toFixed(3)}</strong></td><td><span class={`badge ${row.planCalculationStatus}`}>{statusLabel(row.planCalculationStatus)}</span><span class="cell-sub">{row.planConfidence} confidence</span></td></tr>
    ))}</tbody></table></div></div>
  </section>

  <section class="section compact">
    <div class="section-heading"><div><p class="section-kicker">Access-price frontier</p><h2>Cheapest subscription access to each directly benchmarked intelligence level</h2></div><p>Allowance is deliberately ignored here. This answers which subscription exposes the route at the lowest monthly entry price.</p></div>
    <div class="raw-leader-strip">{accessPrice.slice(0, 10).map((row) => (
      <a class="raw-leader" href={`/plans/${row.planId}`}><strong>{row.modelIntelligenceIndex}</strong><span>{row.provider} · {row.plan}</span><small>{row.model} · ${row.priceMonthly}/mo</small></a>
    ))}</div>
  </section>

  <section class="section compact">
    <div class="section-heading"><div><p class="section-kicker">Raw subsidy appendix</p><h2>Allowance-only leaders</h2></div><p>This is where StepFun and other enormous cheap-model pools belong. The table is useful, but it is no longer the default market verdict.</p></div>
    <div class="panel"><div class="table-shell"><table><thead><tr><th>Plan</th><th>Price</th><th>Raw allowance multiple</th><th>Evidence</th><th>Meaning</th></tr></thead><tbody>{rawLeaders.map((plan) => (
      <tr><td><a href={`/plans/${plan.id}`}><strong>{plan.provider} · {plan.name}</strong></a></td><td class="numeric">{plan.priceDisplay}</td><td class="numeric">{plan.valueDisplay}</td><td><span class={`badge ${plan.calculationStatus}`}>{statusLabel(plan.calculationStatus)}</span></td><td>{plan.headline}</td></tr>
    ))}</tbody></table></div></div>
  </section>
</BaseLayout>
