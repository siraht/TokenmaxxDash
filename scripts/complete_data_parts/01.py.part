#!/usr/bin/env python3
"""Complete the generated catalog with current external evidence and quality-aware economics.

This script intentionally does not run benchmarks or ingest private telemetry. It combines:
- plan/rate-card facts generated by build_data.py;
- externally published model and coding-agent benchmarks;
- explicit community measurements for hidden subscription pools; and
- deterministic, reviewable calculations over those inputs.

Provider-hidden quantities remain ranges. A plan is never assigned a benchmark score merely
because it advertises a broad family label or an unverified gateway alias.
"""
from __future__ import annotations

import json
import math
import re
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Iterable

ROOT = Path(__file__).resolve().parents[1]
DATA = ROOT / "src" / "data"
AS_OF = "2026-08-18"
AVERAGE_WEEKS_PER_MONTH = 365.2425 / 12 / 7


def read_json(name: str) -> Any:
    return json.loads((DATA / name).read_text())


def write_json(name: str, value: Any) -> None:
    text = json.dumps(value, indent=2, ensure_ascii=False) + "\n"
    (DATA / name).write_text(text)


def slug(value: str) -> str:
    value = value.lower().replace("+", " plus ")
    value = re.sub(r"[^a-z0-9]+", "-", value).strip("-")
    return value or "unknown"


def upsert(rows: list[dict[str, Any]], row: dict[str, Any]) -> None:
    for index, existing in enumerate(rows):
        if existing["id"] == row["id"]:
            rows[index] = row
            return
    rows.append(row)


def round_or_none(value: float | None, digits: int = 6) -> float | None:
    return None if value is None else round(value, digits)


def model_benchmark(
    *,
    id: str,
    model: str,
    provider: str,
    score: float,
    input_price: float | None,
    cache_price: float | None,
    output_price: float | None,
    source_id: str,
    speed: float | None = None,
    write_price: float | None = None,
    context_k: int | None = None,
    evaluation_cost: float | None = None,
    effort: str | None = None,
    version_note: str | None = None,
) -> dict[str, Any]:
    # Artificial Analysis's displayed blend is 70% cache reads, 20% fresh input, 10% output.
    # Keep it null when any component is missing; zero is a real price, not an unknown sentinel.
    blended = (
        0.7 * cache_price + 0.2 * input_price + 0.1 * output_price
        if input_price is not None and cache_price is not None and output_price is not None
        else None
    )
    return {
        "id": id,
        "kind": "model-intelligence",
        "benchmark": "Artificial Analysis Intelligence Index",
        "version": "current snapshot",
        "provider": provider,
        "model": model,
        "score": score,
        "inputPricePerMUsd": input_price,
        "cachedInputPricePerMUsd": cache_price,
        "cacheWritePricePerMUsd": write_price,
        "outputPricePerMUsd": output_price,
        "blendedPricePerMUsd": round(blended, 6) if blended is not None else None,
        "blendedUsdPerIntelligencePoint": round(blended / score, 8) if blended is not None and score else None,
        "intelligencePointsPerBlendedUsd": round(score / blended, 6) if blended else None,
        "outputTokensPerSecond": speed,
        "contextWindowK": context_k,
        "evaluationCostUsd": evaluation_cost,
        "effort": effort,
        "sourceId": source_id,
        "retrievedAt": AS_OF,
        "versionNote": version_note,
        "costMeaning": "Public API token price normalized with Artificial Analysis's 7:2:1 cache-read/fresh-input/output convention; not subscription cost.",
    }


def agent_benchmark(
    *,
    id: str,
    agent: str,
    model: str,
    score: float,
    cost: float | None,
    time: float | None,
    tokens: float | None,
    source_id: str,
    deep: float | None = None,
    terminal: float | None = None,
    atlas: float | None = None,
    cache: float | None = None,
    turns: float | None = None,
    version: str = "v1.3",
) -> dict[str, Any]:
    pass_rate = score / 100
    return {
        "id": id,
        "kind": "coding-agent",
        "benchmark": "Artificial Analysis Coding Agent Index",
        "version": version,
        "agent": agent,
        "model": model,
        "score": score,
        "deepSWE": deep,
        "terminalBenchV2": terminal,
        "sweAtlasQnA": atlas,
        "apiCostPerTaskUsd": cost,
        "apiUsdPerExpectedPass": round(cost / pass_rate, 6) if cost is not None and pass_rate else None,
        "expectedPassesPerApiDollar": round(pass_rate / cost, 6) if cost else None,
        "timePerTaskMinutes": time,
        "minutesPerExpectedPass": round(time / pass_rate, 6) if time is not None and pass_rate else None,
        "tokensPerTaskM": tokens,
        "tokensPerExpectedPassM": round(tokens / pass_rate, 6) if tokens is not None and pass_rate else None,
        "cacheHitRate": cache,
        "turnsPerTask": turns,
        "sourceId": source_id,
        "retrievedAt": AS_OF,
        "costMeaning": "Average pay-per-token API cost per task published by Artificial Analysis; not consumer subscription allocation.",
    }


def terminal_benchmark(
    *, id: str, agent: str, model: str, effort: str, score: float, error: float,
    total_cost: float, source_id: str, date: str,
) -> dict[str, Any]:
    return {
        "id": id,
        "kind": "coding-agent",
        "benchmark": "Terminal-Bench",
        "version": "2.1",
        "agent": agent,
        "model": model,
        "effort": effort,
        "score": score,
        "confidenceIntervalPct": error,
        "reportedTotalRunCostUsd": total_cost,
        "sourceId": source_id,
        "retrievedAt": AS_OF,
        "resultDate": date,
        "costMeaning": "Leaderboard total run cost. No per-task or per-attempt cost is derived because the public row does not expose a stable denominator in this snapshot.",
    }


def pareto(
    rows: Iterable[dict[str, Any]],
    *,
    maximize: tuple[str, ...] = (),
    minimize: tuple[str, ...] = (),
) -> list[str]:
    candidates = list(rows)
    frontier: list[str] = []
    for row in candidates:
        values = [row.get(k) for k in maximize + minimize]
        if any(v is None or not isinstance(v, (int, float)) or not math.isfinite(v) for v in values):
            continue
        dominated = False
        for other in candidates:
            if other is row:
                continue
            ovalues = [other.get(k) for k in maximize + minimize]
            if any(v is None or not isinstance(v, (int, float)) or not math.isfinite(v) for v in ovalues):
                continue
            weak = all(other[k] >= row[k] for k in maximize) and all(other[k] <= row[k] for k in minimize)
            strict = any(other[k] > row[k] for k in maximize) or any(other[k] < row[k] for k in minimize)
            if weak and strict:
                dominated = True
                break
        if not dominated:
            frontier.append(row["id"])
    return frontier


def quality_band(score: float | None) -> str:
    if score is None:
        return "unbenchmarked"
    if score >= 65:
        return "elite"
    if score >= 60:
        return "frontier"
    if score >= 50:
        return "capable"
    if score >= 30:
        return "volume"
    return "basic"


def confidence_factor(value: str | None) -> float:
    return {"high": 1.0, "medium": 0.8, "low": 0.55}.get(value or "", 0.4)


plans: list[dict[str, Any]] = read_json("plans.json")
sources: list[dict[str, Any]] = read_json("sources.json")
base_benchmarks: list[dict[str, Any]] = read_json("benchmarks.json")
summary: dict[str, Any] = read_json("summary.json")
methodology: dict[str, Any] = read_json("methodology.json")

