    "aa-agent-cursor-composer-2-5-fast": {"apiCostPerTaskUsd": 0.55, "timePerTaskMinutes": 6.8, "tokensPerTaskM": 4.2},
}
for row in benchmarks:
    patch = AGENT_UPDATES.get(row["id"])
    if patch:
        row.update(patch)
        pass_rate = row["score"] / 100
        if row.get("apiCostPerTaskUsd") is not None:
            row["apiUsdPerExpectedPass"] = round(row["apiCostPerTaskUsd"] / pass_rate, 6)
            row["expectedPassesPerApiDollar"] = round(pass_rate / row["apiCostPerTaskUsd"], 6)
        if row.get("timePerTaskMinutes") is not None:
            row["minutesPerExpectedPass"] = round(row["timePerTaskMinutes"] / pass_rate, 6)
        if row.get("tokensPerTaskM") is not None:
            row["tokensPerExpectedPassM"] = round(row["tokensPerTaskM"] / pass_rate, 6)

