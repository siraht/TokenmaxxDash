def make_plan(
    provider: str,
    name: str,
    price: float | None,
    *,
    provider_id: str | None = None,
    currency: str = "USD",
    category: str = "coding-subscription",
    status: str = "active",
    region: str = "Global",
    calculation_status: str = "opaque",
    confidence: str = "unknown",
    allowance_type: str = "opaque quota",
    headline: str = "Allowance is not numerically published.",
    sources_: list[str] | None = None,
    value_multiple: float | None = None,
    value_multiple_low: float | None = None,
    value_multiple_high: float | None = None,
    included_value_usd: float | None = None,
    formula: str | None = None,
    quotas: dict[str, Any] | None = None,
    models: list[str] | None = None,
    notes: list[str] | None = None,
    eligibility: str = "interactive-coding",
    exactness: str | None = None,
    unit: str | None = None,
    plan_units: float | None = None,
    sort_value: float | None = None,
    details: dict[str, Any] | None = None,
) -> dict[str, Any]:
    pid = provider_id or slug(provider)
    plan_id = f"{pid}-{slug(name)}"
    return {
        "id": plan_id,
        "providerId": pid,
        "provider": provider,
        "name": name,
        "priceMonthly": price,
        "currency": currency,
        "category": category,
