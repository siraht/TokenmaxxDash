# Canonical status fields and readable denominator labels for every remaining plan.
def replace_legacy_unknown_label(value: Any) -> Any:
    if isinstance(value, str):
        return re.sub(r"\bopaque\b", "provider-hidden", value, flags=re.I)
    if isinstance(value, list):
        return [replace_legacy_unknown_label(item) for item in value]
    if isinstance(value, dict):
        return {key: replace_legacy_unknown_label(item) for key, item in value.items()}
    return value

plans = [replace_legacy_unknown_label(plan) for plan in plans]
sources = [replace_legacy_unknown_label(source) for source in sources]

for p in plans:
    p.setdefault("normalizationState", p.get("calculationStatus", "secondary"))
    p.setdefault("bindingUnknowns", [])
    p.setdefault("planDenominator", p.get("unit"))
    p.setdefault("routeConfidence", "direct" if p.get("models") else "catalog")
    p.setdefault("effectiveAt", p.get("lastVerified", AS_OF))
    p.setdefault("observedAt", AS_OF)
    p.setdefault("workloadEligibility", {
        "interactiveCoding": p.get("eligibility") in {"interactive-coding", "interactive-coding-only", "api-and-coding-tools"},
        "unattendedAutomation": "unknown",
        "applicationBackend": "unknown",
    })
    if p.get("calculationStatus") == "opaque":
        raise RuntimeError(f"opaque status survived enrichment: {p['id']}")
    if not p.get("valueDisplay") or p.get("valueDisplay") == "Unresolved":
        p["valueDisplay"] = {
            "provider-hidden": "Provider-hidden limit",
            "partial": "Partial normalization",
            "secondary": "Secondary evidence",
            "measured-range": "Measured range",
            "legacy": "Legacy plan",
        }.get(p.get("calculationStatus"), "Unit allowance")
    if p.get("includedValueUsdMonthly") is None and p.get("planUnits") is not None and p["valueDisplay"] in {"Partial normalization", "Secondary evidence", "Unit allowance"}:
        p["valueDisplay"] = f"{p['planUnits']:,} {p.get('unit') or 'plan units'}"

# External model-intelligence snapshot. Prices are $/1M tokens; blended uses 70% cache, 20% fresh input, 10% output.
def model_row(id_: str, provider: str, model: str, score: float, input_: float, cache: float, output: float, speed: float | None, ttft: float | None = None, notes: str | None = None) -> dict[str, Any]:
    blended = 0.7 * cache + 0.2 * input_ + 0.1 * output
    return {
        "id": id_, "kind": "model-intelligence", "benchmark": "Artificial Analysis Intelligence Index", "version": "v4.1",
        "provider": provider, "model": model, "score": score,
        "inputPricePerMUsd": input_, "cachedInputPricePerMUsd": cache, "outputPricePerMUsd": output,
        "blendedPricePerMUsd": round(blended, 6), "outputTokensPerSecond": speed, "timeToFirstTokenSeconds": ttft,
        "sourceId": "aa-intelligence-index-v4-1", "retrievedAt": AS_OF,
        "costMeaning": "Artificial Analysis 7:2:1 cache/fresh-input/output blended model price; not a subscription allocation.",
        "notes": notes,
    }

