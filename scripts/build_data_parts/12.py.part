        sources_=["codingplans-cc"], formula="subscription price per product credit = monthly price / included credits",
        quotas={"monthlyCredits": credits, "eurPerCredit": q(Decimal(str(price_eur))/Decimal(credits), "0.0001")}, models=["VULK managed agent"], unit="VULK credit", plan_units=credits,
    ))
