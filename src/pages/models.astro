---
import BaseLayout from '../layouts/BaseLayout.astro';
import models from '../data/models.json';
const ordered = [...models].sort((a,b) => (b.bestModelIntelligenceScore ?? -1) - (a.bestModelIntelligenceScore ?? -1) || a.name.localeCompare(b.name));
const counts = ordered.reduce((acc, row) => { acc[row.benchmarkCoverage] = (acc[row.benchmarkCoverage] || 0) + 1; return acc; }, {});
---
<BaseLayout title="Models" description="Every model route advertised by a tracked coding plan, with direct external benchmark coverage or an explicit missing-evidence label.">
  <section class="page-intro"><p class="eyebrow">{models.length} advertised routes</p><h1>Every model gets a coverage record, not a borrowed score.</h1><p class="lede">Direct external results enter rankings. Broad catalogs, managed-agent labels, and unmatched model aliases remain visible with an explicit exclusion reason, so “available on the plan” is never confused with “benchmarked in that product.”</p></section>
  <section class="section compact"><div class="kpi-grid"><article class="kpi-card"><strong>{counts['direct-agent-and-model'] || 0}</strong><span>direct agent and model evidence</span></article><article class="kpi-card"><strong>{counts['direct-model'] || 0}</strong><span>direct model-only evidence</span></article><article class="kpi-card"><strong>{counts['direct-agent'] || 0}</strong><span>direct agent-only evidence</span></article><article class="kpi-card"><strong>{(counts['no-external-benchmark'] || 0) + (counts['catalog-only'] || 0)}</strong><span>explicitly unbenchmarked or broad labels</span></article></div></section>
  <section class="section compact"><div class="panel"><div class="table-shell"><table><thead><tr><th>Model route</th><th>Plans</th><th>Coverage</th><th>Model intelligence</th><th>Blended $/M</th><th>$/M/intelligence point</th><th>Best agent index</th><th>Reason</th></tr></thead><tbody>{ordered.map((row) => <tr><td><strong>{row.name}</strong></td><td class="numeric">{row.planCount}</td><td><span class={`coverage-${row.benchmarkCoverage}`}>{row.benchmarkCoverage}</span></td><td class="numeric">{row.bestModelIntelligenceScore ?? '—'}</td><td class="numeric">{row.bestModelBlendedPricePerMUsd != null ? `$${row.bestModelBlendedPricePerMUsd.toFixed(3)}` : '—'}</td><td class="numeric">{row.blendedUsdPerIntelligencePoint != null ? `$${row.blendedUsdPerIntelligencePoint.toFixed(5)}` : '—'}</td><td class="numeric">{row.bestCodingAgentScore ?? '—'}</td><td>{row.exclusionReason || 'Direct external evidence attached.'}</td></tr>)}</tbody></table></div></div></section>
</BaseLayout>
