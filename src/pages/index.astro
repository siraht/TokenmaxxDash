---
import BaseLayout from '../layouts/BaseLayout.astro';
import guide from '../data/buyer-guide.json';

const routeById = new Map(guide.rows.map((row) => [row.id, row]));
const confidenceLabel = (value) => ({ official: 'Official', derived: 'Derived', measured: 'Measured', 'measured-low': 'Measured range', 'official-partial': 'Official partial', secondary: 'Secondary' }[value] || value || 'Unknown');
const money = (value, digits = 3) => typeof value === 'number' ? `$${value.toFixed(digits)}` : '—';
const number = (value, digits = 1) => typeof value === 'number' ? value.toLocaleString('en-US', { maximumFractionDigits: digits }) : '—';
const metricText = (row, mix, key) => {
  const value = row[mix]?.[key];
  if (typeof value !== 'number') return '—';
  return `$${value.toFixed(value < .01 ? 5 : 3)}`;
};
const bandById = new Map((guide.recommendationBands || []).map((band) => [band.id, band]));
const shortlist = Object.entries(guide.shortlists.standard || {}).map(([band, ids]) => ({ band, row: routeById.get(ids?.[0]) })).filter((entry) => entry.row);
const baselines = guide.planSummaries.filter((plan) => ['OpenAI Codex', 'Claude Code', 'Grok Build', 'Synthetic'].includes(plan.provider));
const rows = [...guide.rows].sort((a, b) => (a.standard.qualityAdjustedUsdPerM ?? Infinity) - (b.standard.qualityAdjustedUsdPerM ?? Infinity));
---
<BaseLayout title="Tokenmaxx">
  <section class="hero">
    <div>
      <p class="eyebrow">Every monthly coding subscription, one useful comparison</p>
      <h1>Find the most capable model tokens your next subscription can buy.</h1>
      <p class="lede">Compare each plan × model route by effective subscription dollars per million tokens, external intelligence, coding-task success, and cost per successful benchmark-equivalent task. Claude Code, Codex, Grok, Synthetic, and every alternative stay visible by default.</p>
    </div>
    <aside class="hero-side"><strong>{guide.summary.planCount}</strong><span>monthly plans researched</span><p>{guide.summary.comparableRouteCount} token-comparable routes, {guide.summary.requestRouteCount} request-comparable routes, and {guide.summary.unquantifiedPlanCount} plans whose exact missing denominator is documented.</p></aside>
  </section>

  <section class="section compact"><div class="kpis">
    <article class="kpi"><strong>{guide.summary.comparisonClassCounts?.token || 0}</strong><span>token-denominated plans</span></article>
    <article class="kpi"><strong>{guide.summary.comparisonClassCounts?.request || 0}</strong><span>request-denominated plans</span></article>
    <article class="kpi"><strong>{guide.summary.comparisonClassCounts?.managed || 0}</strong><span>managed/work-unit plans</span></article>
    <article class="kpi"><strong>{guide.summary.comparisonClassCounts?.relative || 0}</strong><span>relative-capacity plans</span></article>
    <article class="kpi"><strong>{guide.summary.comparisonClassCounts?.calibratable || 0}</strong><span>account-calibratable plans</span></article>
    <article class="kpi"><strong>{guide.summary.comparisonClassCounts?.['provider-hidden'] || 0}</strong><span>provider-hidden numeric pools</span></article>
  </div></section>

  <section class="section">
    <div class="section-heading"><div><p class="section-kicker">Universal shortlist</p><h2>Best value at common monthly budgets</h2></div><p>These cards include every provider, including plans marked as already owned. Hide-owned is an optional filter below.</p></div>
    <div class="shortlist-grid">{shortlist.map(({ band, row }) => (
      <a class="shortlist-card" href={`/plans/${row.planId}`}><span class="budget">{bandById.get(band)?.label || band}</span><h3>{row.provider} · {row.plan}</h3><p>{row.model} · intelligence {row.intelligence ?? '—'} · coding {row.codingScore?.toFixed(0) ?? '—'}</p><span class="metric">{money(row.standard.qualityAdjustedUsdPerM, 4)}</span><span class="metric-label">quality-adjusted subscription $ / 1M raw tokens</span></a>
    ))}</div>
  </section>

  <section class="section">
    <div class="section-heading"><div><p class="section-kicker">Plan × model comparison</p><h2>Sort by the metric that matches your workload</h2></div><p>Standardized is 70% cache reads, 20% fresh input, and 10% output. Agentic high-cache uses public coding-agent telemetry.</p></div>
    <div class="toolbar">
      <div class="control"><label for="buyer-search">Search</label><input id="buyer-search" data-buyer-search type="search" placeholder="OpenCode, Luna, Kimi, Claude…" /></div>
      <div class="control"><label for="buyer-mix">Token mix</label><select id="buyer-mix" data-buyer-mix><option value="standard">Standardized 7:2:1</option><option value="agentic">Agentic high-cache</option></select></div>
      <div class="control"><label for="buyer-quality">Minimum intelligence</label><select id="buyer-quality" data-buyer-quality><option value="0">All scored models</option><option value="40">40+</option><option value="50">50+</option><option value="55">55+</option></select></div>
      <div class="control"><label for="buyer-budget">Maximum price</label><select id="buyer-budget" data-buyer-budget><option value="10000">Any price</option><option value="10">$10</option><option value="25">$25</option><option value="50">$50</option><option value="100">$100</option><option value="200">$200</option></select></div>
      <div class="control"><label for="buyer-evidence">Evidence</label><select id="buyer-evidence" data-buyer-evidence><option value="all">All evidence</option><option value="primary">Official + measured</option><option value="official">Official only</option></select></div>
      <div class="control"><label for="buyer-sort">Sort</label><select id="buyer-sort" data-buyer-sort><option value="quality-cost">Quality-adjusted $/M</option><option value="token-cost">Subscription $/M</option><option value="task-cost">$/successful task</option><option value="intelligence">Intelligence</option><option value="coding">Coding score</option><option value="tokens">Monthly raw tokens</option><option value="price">Plan price</option></select></div>
      <div class="control checkbox-control"><label><input type="checkbox" data-buyer-owned /> Hide plans I already own</label></div>
    </div>
    <div class="results-line"><span data-buyer-count>{rows.length} comparable routes</span><span>Owned status is personal metadata, never a default exclusion.</span></div>
    <div class="panel" style="margin-top:10px"><div class="table-shell"><table data-buyer-table>
      <thead><tr><th>#</th><th>Subscription / model</th><th>Price</th><th>Intelligence</th><th>Coding</th><th>Route API $/M</th><th>Raw tokens/mo</th><th>Subscription $/M</th><th>Quality-adjusted $/M</th><th>$/successful task</th><th>Evidence</th></tr></thead>
      <tbody>{rows.map((row, index) => (
        <tr data-buyer-row data-search={`${row.provider} ${row.plan} ${row.model} ${row.modelProvider}`.toLowerCase()} data-owned={String(row.owned)} data-confidence={row.confidence} data-price={row.priceUsd} data-intelligence={row.intelligence ?? -1} data-coding={row.codingScore ?? -1}
          data-standard-rate={row.standard.apiRatePerM ?? ''} data-standard-tokens={row.standard.monthlyTokensM ?? ''} data-standard-cost={row.standard.subscriptionUsdPerM ?? ''} data-standard-quality-cost={row.standard.qualityAdjustedUsdPerM ?? ''} data-standard-task-cost={row.standard.subscriptionUsdPerSuccessfulTask ?? ''}
          data-agentic-rate={row.agentic.apiRatePerM ?? ''} data-agentic-tokens={row.agentic.monthlyTokensM ?? ''} data-agentic-cost={row.agentic.subscriptionUsdPerM ?? ''} data-agentic-quality-cost={row.agentic.qualityAdjustedUsdPerM ?? ''} data-agentic-task-cost={row.agentic.subscriptionUsdPerSuccessfulTask ?? ''}>
          <td class="numeric"><span class="rank-number" data-row-rank>{index + 1}</span></td>
          <td class="cell-stack"><a href={`/plans/${row.planId}`}><strong>{row.provider} · {row.plan}</strong></a><span class="cell-sub">{row.model} · {row.standard.rateBasis}</span>{row.owned && <span class="badge owned" style="margin-top:5px">Owned</span>}</td>
          <td class="numeric">${row.priceUsd.toFixed(2)}</td><td class="numeric"><span class={`score ${(row.intelligence || 0) < 50 ? 'low' : ''}`}>{row.intelligence?.toFixed(1) ?? '—'}</span></td><td class="numeric">{row.codingScore?.toFixed(1) ?? '—'}</td>
          <td class="numeric"><span data-metric-standard={metricText(row, 'standard', 'apiRatePerM')} data-metric-agentic={metricText(row, 'agentic', 'apiRatePerM')}>{metricText(row, 'standard', 'apiRatePerM')}</span></td>
          <td class="numeric"><span data-metric-standard={`${number(row.standard.monthlyTokensM, 1)}M`} data-metric-agentic={`${number(row.agentic.monthlyTokensM, 1)}M`}>{number(row.standard.monthlyTokensM, 1)}M</span></td>
          <td class="numeric"><strong data-metric-standard={metricText(row, 'standard', 'subscriptionUsdPerM')} data-metric-agentic={metricText(row, 'agentic', 'subscriptionUsdPerM')}>{metricText(row, 'standard', 'subscriptionUsdPerM')}</strong></td>
          <td class="numeric"><strong data-metric-standard={metricText(row, 'standard', 'qualityAdjustedUsdPerM')} data-metric-agentic={metricText(row, 'agentic', 'qualityAdjustedUsdPerM')}>{metricText(row, 'standard', 'qualityAdjustedUsdPerM')}</strong></td>
          <td class="numeric"><span data-metric-standard={metricText(row, 'standard', 'subscriptionUsdPerSuccessfulTask')} data-metric-agentic={metricText(row, 'agentic', 'subscriptionUsdPerSuccessfulTask')}>{metricText(row, 'standard', 'subscriptionUsdPerSuccessfulTask')}</span></td>
          <td><span class={`badge ${row.confidence}`}>{confidenceLabel(row.confidence)}</span><span class="cell-sub">{row.accessMode || 'included'}</span></td>
        </tr>
      ))}</tbody>
    </table></div><div class="empty-state" data-buyer-empty>No route matches those filters.</div></div>
  </section>

  <section class="section">
    <div class="section-heading"><div><p class="section-kicker">Baseline subscriptions</p><h2>Claude, Codex, Grok, and Synthetic remain in the public comparison</h2></div><p>Plans without a defensible token denominator still appear with their exact missing fields instead of fabricated token estimates.</p></div>
    <div class="plan-grid">{baselines.map((plan) => (
      <a class="plan-card" href={`/plans/${plan.id}`}><div class="topline"><div><strong>{plan.provider}</strong><span class="cell-sub">{plan.plan}</span></div><span class="price">${plan.priceUsd.toFixed(2)}</span></div><p>{plan.comparisonClass} · {plan.researchStatus}</p><div class="best"><strong>{plan.bestAgenticModel || 'No token denominator'}</strong><span class="cell-sub">{plan.bestAgenticQualityCost != null ? `${money(plan.bestAgenticQualityCost, 4)} quality-adjusted $/M` : plan.missingFields.join(' · ')}</span></div></a>
    ))}</div>
  </section>

  <section class="section"><div class="section-heading"><div><p class="section-kicker">Every researched plan</p><h2>Token, request, managed, relative, calibratable, and provider-hidden products</h2></div><a href="/plans">Open full plan catalog →</a></div>
    <div class="plan-grid" data-plan-grid>{guide.planSummaries.map((plan) => (
      <a class="plan-card" href={`/plans/${plan.id}`} data-plan-card data-search={`${plan.provider} ${plan.plan} ${plan.comparisonClass}`.toLowerCase()} data-provider={plan.provider} data-confidence={plan.confidence} data-quantified={plan.tokenRouteCount || plan.requestRouteCount ? 'yes' : 'no'} data-price={plan.priceUsd} data-quality-cost={plan.bestAgenticQualityCost ?? 999999}><div class="topline"><div><strong>{plan.provider}</strong><span class="cell-sub">{plan.plan}</span></div><span class="price">${plan.priceUsd.toFixed(2)}</span></div><p>{plan.comparisonClass} · {plan.researchStatus}</p><div class="best"><strong>{plan.bestAgenticModel || `${plan.allowanceKind} allowance`}</strong><span class="cell-sub">{plan.bestAgenticQualityCost != null ? `${money(plan.bestAgenticQualityCost, 4)} quality-adjusted $/M` : plan.missingFields.slice(0, 2).join(' · ')}</span></div></a>
    ))}</div>
  </section>
</BaseLayout>
