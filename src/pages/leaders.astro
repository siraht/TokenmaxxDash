---
import BaseLayout from '../layouts/BaseLayout.astro';
import benchmarks from '../data/benchmarks.json';
import leaders from '../data/leaders.json';
import qualityRoutes from '../data/quality-routes.json';
import taskEstimates from '../data/subscription-task-estimates.json';
import { statusLabel } from '../lib/format';

const benchmarkById = new Map(benchmarks.map((row) => [row.id, row]));
const routeById = new Map(qualityRoutes.map((row) => [row.id, row]));
const costQuality = leaders.codingAgentCostQualityPareto.map((id) => benchmarkById.get(id)).filter(Boolean);
const timeQuality = leaders.codingAgentTimeQualityPareto.map((id) => benchmarkById.get(id)).filter(Boolean);
const tokenQuality = leaders.codingAgentTokenQualityPareto.map((id) => benchmarkById.get(id)).filter(Boolean);
const modelPrice = leaders.modelPriceIntelligencePareto.map((id) => benchmarkById.get(id)).filter(Boolean);
const modelSpeed = leaders.modelSpeedIntelligencePareto.map((id) => benchmarkById.get(id)).filter(Boolean);
const planModel = leaders.planModelValueIntelligencePareto.map((id) => routeById.get(id)).filter(Boolean);
const planAccess = leaders.planAccessPriceIntelligencePareto.map((id) => routeById.get(id)).filter(Boolean);
const bestTask = [...taskEstimates].sort((a,b) => (a.subscriptionUsdPerExpectedPass ?? Infinity) - (b.subscriptionUsdPerExpectedPass ?? Infinity)).slice(0,12);
---
<BaseLayout title="Pareto leaders" description="Non-dominated coding subscriptions, models, and agent configurations across intelligence, task cost, token use, speed, access price, and quantified allowance.">
  <section class="page-intro"><p class="eyebrow">No arbitrary master score</p><h1>Leaders depend on which compromise you’ll accept.</h1><p class="lede">Each table is a Pareto frontier: a row survives only when no imported alternative is at least as strong on quality and at least as good on the selected economic or performance axis. Intelligence scores and pass-rate-like coding scores remain separate.</p></section>

  <section class="section compact"><div class="frontier-grid">
    <article class="panel"><div class="panel-header"><div><h3>Coding quality vs API cost/task</h3><p>Artificial Analysis Coding Agent Index</p></div></div><div class="table-shell"><table><thead><tr><th>Configuration</th><th>Index</th><th>$/task</th><th>$/expected pass</th></tr></thead><tbody>{costQuality.map((r) => <tr><td><strong>{r.agent}</strong><span class="cell-sub">{r.model}</span></td><td class="numeric">{r.score}</td><td class="numeric">${r.apiCostPerTaskUsd?.toFixed(2)}</td><td class="numeric">${r.apiUsdPerExpectedPass?.toFixed(3)}</td></tr>)}</tbody></table></div></article>
    <article class="panel"><div class="panel-header"><div><h3>Coding quality vs wall time</h3><p>Faster is useful only when the task still passes.</p></div></div><div class="table-shell"><table><thead><tr><th>Configuration</th><th>Index</th><th>Time/task</th><th>Minutes/expected pass</th></tr></thead><tbody>{timeQuality.map((r) => <tr><td><strong>{r.agent}</strong><span class="cell-sub">{r.model}</span></td><td class="numeric">{r.score}</td><td class="numeric">{r.timePerTaskMinutes?.toFixed(1)}m</td><td class="numeric">{r.minutesPerExpectedPass?.toFixed(1)}m</td></tr>)}</tbody></table></div></article>
  </div></section>

  <section class="section"><div class="section-heading"><div><p class="section-kicker">Context efficiency</p><h2>Coding quality versus raw tokens per task</h2></div><p>Raw-token efficiency captures context and agent-turn behavior; it is separate from dollar cost because cache rates and output prices differ.</p></div><div class="panel"><div class="table-shell"><table><thead><tr><th>Configuration</th><th>Index</th><th>Raw tokens/task</th><th>Raw tokens/expected pass</th><th>Cache share</th></tr></thead><tbody>{tokenQuality.map((r) => <tr><td><strong>{r.agent}</strong><span class="cell-sub">{r.model}</span></td><td class="numeric">{r.score}</td><td class="numeric">{r.tokensPerTaskM?.toFixed(2)}M</td><td class="numeric">{r.tokensPerTaskM != null ? `${(r.tokensPerTaskM / (r.score / 100)).toFixed(2)}M` : '—'}</td><td class="numeric">{r.cacheSharePct != null ? `${r.cacheSharePct.toFixed(1)}%` : '—'}</td></tr>)}</tbody></table></div></div></section>

  <section class="section"><div class="section-heading"><div><p class="section-kicker">Model economics</p><h2>Intelligence versus blended token price</h2></div><p>The blended price uses Artificial Analysis’s 70% cache-read, 20% fresh-input, 10% output convention. Dollars per Intelligence Index point is a cost-density signal, not a task-success probability.</p></div><div class="panel"><div class="table-shell"><table><thead><tr><th>Model</th><th>Intelligence</th><th>7:2:1 blended $/M</th><th>$/M/intelligence point</th><th>Output speed</th></tr></thead><tbody>{modelPrice.map((r) => <tr><td><strong>{r.model}</strong><span class="cell-sub">{r.provider}</span></td><td class="numeric">{r.score}</td><td class="numeric">${r.blendedPricePerMUsd?.toFixed(3)}</td><td class="numeric">${r.blendedUsdPerIntelligencePoint?.toFixed(5)}</td><td class="numeric">{r.outputTokensPerSecond?.toFixed(1) ?? '—'} t/s</td></tr>)}</tbody></table></div></div></section>

  <section class="section"><div class="section-heading"><div><p class="section-kicker">Latency frontier</p><h2>Intelligence versus output speed</h2></div><p>A cheap model can still be operationally poor if it is slow, while a fast model can be uneconomic or insufficiently capable.</p></div><div class="panel"><div class="table-shell"><table><thead><tr><th>Model</th><th>Intelligence</th><th>Output speed</th><th>Blended $/M</th></tr></thead><tbody>{modelSpeed.map((r) => <tr><td><strong>{r.model}</strong><span class="cell-sub">{r.provider}</span></td><td class="numeric">{r.score}</td><td class="numeric">{r.outputTokensPerSecond?.toFixed(1)} t/s</td><td class="numeric">${r.blendedPricePerMUsd?.toFixed(3)}</td></tr>)}</tbody></table></div></div></section>

  <section class="section"><div class="section-heading"><div><p class="section-kicker">Access-price frontier</p><h2>Monthly subscription price versus direct model intelligence</h2></div><p>This answers the narrow question “what is the cheapest subscription that exposes this intelligence level?” It deliberately ignores allowance size, so evidence and allowance remain visible.</p></div><div class="panel"><div class="table-shell"><table><thead><tr><th>Plan / model</th><th>Price</th><th>Intelligence</th><th>Subscription $/intelligence point</th><th>Allowance evidence</th><th>Allowance</th></tr></thead><tbody>{planAccess.map((r) => <tr><td><a href={`/plans/${r.planId}`}><strong>{r.provider} · {r.plan}</strong></a><span class="cell-sub">{r.model}</span></td><td class="numeric">${r.priceMonthly.toFixed(2)}/mo</td><td class="numeric">{r.intelligenceIndex}</td><td class="numeric">${r.subscriptionUsdPerIntelligencePoint?.toFixed(4)}</td><td><span class={`badge ${r.planCalculationStatus}`}>{statusLabel(r.planCalculationStatus)}</span></td><td>{r.planValueDisplay}</td></tr>)}</tbody></table></div></div></section>

  <section class="section"><div class="section-heading"><div><p class="section-kicker">Subscription allowance</p><h2>Quantified plan value versus direct model intelligence</h2></div><p>This is a two-axis plan/model frontier. The quality-adjusted cost is a labeled heuristic; the frontier itself uses the original allowance and intelligence dimensions.</p></div><div class="panel"><div class="table-shell"><table><thead><tr><th>Plan / model</th><th>Plan value multiple</th><th>Intelligence</th><th>Quality-adjusted subsidy signal</th><th>Subscription $/quality-adjusted value $</th><th>Transfer limit</th></tr></thead><tbody>{planModel.map((r) => <tr><td><a href={`/plans/${r.planId}`}><strong>{r.provider} · {r.plan}</strong></a><span class="cell-sub">{r.model}</span></td><td class="numeric">{r.planValueMultiple?.toFixed(3)}×</td><td class="numeric">{r.intelligenceIndex}</td><td class="numeric">{r.qualityAdjustedSubsidySignal?.toFixed(3)}</td><td class="numeric">${r.subscriptionUsdPerQualityAdjustedValueDollar?.toFixed(5)}</td><td>{r.benchmarkTransfer}</td></tr>)}</tbody></table></div></div></section>

  <section class="section"><div class="section-heading"><div><p class="section-kicker">Directly joinable task economics</p><h2>Codex subscription cost per expected external-benchmark pass</h2></div><p>These are the only current rows where a measured plan pool and a native externally tested agent/model route can be joined directly. Five-hour caps and shared ChatGPT usage can bind before the monthly average.</p></div><div class="panel"><div class="table-shell"><table><thead><tr><th>Plan / model</th><th>Index</th><th>Attempts/avg month</th><th>Expected passes/avg month</th><th>Subscription $/expected pass</th></tr></thead><tbody>{bestTask.map((r) => <tr><td><a href={`/plans/${r.planId}`}><strong>{r.provider} · {r.plan}</strong></a><span class="cell-sub">{r.model}</span></td><td class="numeric">{r.score}</td><td class="numeric">{r.estimatedAttemptsPerAverageMonth.toLocaleString()}</td><td class="numeric">{r.expectedBenchmarkPassesPerAverageMonth.toLocaleString()}</td><td class="numeric"><strong>${r.subscriptionUsdPerExpectedPass?.toFixed(4)}</strong></td></tr>)}</tbody></table></div></div></section>
</BaseLayout>
