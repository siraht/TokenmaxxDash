# Lovable and v0 expose recurring pools plus conditional daily grants.
for name, price, monthly, per_credit in [("Pro", 25, 100, 0.25), ("Business", 50, 100, 0.50)]:
    base_value = Decimal(monthly) * Decimal(str(per_credit))
    max_daily_value = Decimal(150) * Decimal(str(per_credit))
    plans.append(make_plan(
        "Lovable", name, price, provider_id="lovable", calculation_status="exact", confidence="high",
        allowance_type="monthly build credits plus daily grants", headline=f"{monthly} purchased build credits plus up to 150 daily-grant credits/month; quantified value ${q(base_value)}–${q(base_value+max_daily_value)}.",
        sources_=["lovable-pricing"], value_multiple_low=q(base_value/Decimal(str(price)), "0.001"), value_multiple_high=q((base_value+max_daily_value)/Decimal(str(price)), "0.001"),
