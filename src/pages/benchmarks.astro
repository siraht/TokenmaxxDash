---
import BaseLayout from '../layouts/BaseLayout.astro';
import guide from '../data/buyer-guide.json';
const rows = guide.models.filter((model) => model.taskBenchmark).sort((a, b) => b.taskBenchmark.passRate - a.taskBenchmark.passRate);
const money = (value) => typeof value === 'number' ? `$${value.toFixed(2)}` : '—';
---
<BaseLayout title="External benchmarks" description="External coding-task pass rates, task token use, API cost, and cost per expected success for models served by monthly coding subscriptions.">
  <section class="page-intro"><p class="eyebrow">No private benchmark suite</p><h1>All task economics come from externally published runs.</h1><p class="lede">The dashboard stores pass rate, raw tokens per task, API-priced cost, harness, benchmark version, and source together. A subscription can use those values only when it serves the exact model route.</p></section>
  <section class="section compact"><div class="callout"><strong>Cost per expected success</strong> = external API cost per attempt ÷ pass rate. Subscription cost per expected success is calculated separately from the plan’s included token capacity.</div></section>
  <section class="section"><div class="panel"><div class="table-shell"><table>
    <thead><tr><th>Model / harness</th><th>Benchmark</th><th>Pass rate</th><th>Raw tokens/task</th><th>API cost/task</th><th>API $/expected success</th><th>Source</th></tr></thead>
    <tbody>{rows.map((model) => { const task = model.taskBenchmark; return (
      <tr><td><strong>{model.name}</strong><span class="cell-sub">{task.harness}</span></td><td>{task.benchmark}</td><td class="numeric"><strong>{(task.passRate * 100).toFixed(1)}%</strong></td><td class="numeric">{task.tokensM.toFixed(2)}M</td><td class="numeric">{money(task.apiCost)}</td><td class="numeric"><strong>{money(task.apiCost / task.passRate)}</strong></td><td><a href={task.source} target="_blank" rel="noreferrer">Evidence ↗</a></td></tr>
    ); })}</tbody>
  </table></div></div></section>
</BaseLayout>
