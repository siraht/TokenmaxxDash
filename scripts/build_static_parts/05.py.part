    write_page("/benchmarks/", layout("External benchmarks", body, "/benchmarks/"))


def build_leaders() -> None:
    benchmark_by_id = {row["id"]: row for row in benchmarks}
    route_by_id = {row["id"]: row for row in quality_routes}
    cost_quality = [benchmark_by_id[row_id] for row_id in leaders["codingAgentCostQualityPareto"] if row_id in benchmark_by_id]
    time_quality = [benchmark_by_id[row_id] for row_id in leaders["codingAgentTimeQualityPareto"] if row_id in benchmark_by_id]
    token_quality = [benchmark_by_id[row_id] for row_id in leaders["codingAgentTokenQualityPareto"] if row_id in benchmark_by_id]
    model_price = [benchmark_by_id[row_id] for row_id in leaders["modelPriceIntelligencePareto"] if row_id in benchmark_by_id]
    model_speed = [benchmark_by_id[row_id] for row_id in leaders["modelSpeedIntelligencePareto"] if row_id in benchmark_by_id]
    plan_model = [route_by_id[row_id] for row_id in leaders["planModelValueIntelligencePareto"] if row_id in route_by_id]
    plan_access = [route_by_id[row_id] for row_id in leaders["planAccessPriceIntelligencePareto"] if row_id in route_by_id]
    cost_rows = "".join(f'<tr><td><strong>{e(r["agent"])}</strong><span class="cell-sub">{e(r["model"])}</span></td><td class="numeric">{fmt(r["score"])}</td><td class="numeric">${fmt(r.get("apiCostPerTaskUsd"),2)}</td><td class="numeric">${fmt(r.get("apiUsdPerExpectedPass"),3)}</td></tr>' for r in cost_quality)
    time_rows = "".join(f'<tr><td><strong>{e(r["agent"])}</strong><span class="cell-sub">{e(r["model"])}</span></td><td class="numeric">{fmt(r["score"])}</td><td class="numeric">{fmt(r.get("timePerTaskMinutes"),1)}m</td><td class="numeric">{fmt(r.get("minutesPerExpectedPass"),1)}m</td></tr>' for r in time_quality)
    token_rows = "".join(f'<tr><td><strong>{e(r["agent"])}</strong><span class="cell-sub">{e(r["model"])}</span></td><td class="numeric">{fmt(r["score"])}</td><td class="numeric">{fmt(r.get("tokensPerTaskM"),2)}M</td><td class="numeric">{fmt((r.get("tokensPerTaskM") or 0)/(r["score"]/100),2)}M</td><td class="numeric">{fmt(r.get("cacheSharePct"),1)}%</td></tr>' for r in token_quality)
    model_price_rows = "".join(f'<tr><td><strong>{e(r["model"])}</strong><span class="cell-sub">{e(r["provider"])}</span></td><td class="numeric">{fmt(r["score"])}</td><td class="numeric">${fmt(r.get("blendedPricePerMUsd"),3)}</td><td class="numeric">${fmt(r.get("blendedUsdPerIntelligencePoint"),5)}</td><td class="numeric">{fmt(r.get("outputTokensPerSecond"),1)} t/s</td></tr>' for r in model_price)
    model_speed_rows = "".join(f'<tr><td><strong>{e(r["model"])}</strong><span class="cell-sub">{e(r["provider"])}</span></td><td class="numeric">{fmt(r["score"])}</td><td class="numeric">{fmt(r.get("outputTokensPerSecond"),1)} t/s</td><td class="numeric">${fmt(r.get("blendedPricePerMUsd"),3)}</td></tr>' for r in model_speed)
    plan_rows = "".join(f'<tr><td><a href="/plans/{e(r["planId"])}/"><strong>{e(r["provider"])} · {e(r["plan"])}</strong></a><span class="cell-sub">{e(r["model"])}</span></td><td class="numeric">{fmt(r.get("planValueMultiple"),3)}×</td><td class="numeric">{fmt(r["intelligenceIndex"])}</td><td class="numeric">{fmt(r.get("qualityAdjustedSubsidySignal"),3)}</td><td class="numeric">${fmt(r.get("subscriptionUsdPerQualityAdjustedValueDollar"),5)}</td><td>{e(r["benchmarkTransfer"])}</td></tr>' for r in plan_model)
    access_rows = "".join(f'<tr><td><a href="/plans/{e(r["planId"])}/"><strong>{e(r["provider"])} · {e(r["plan"])}</strong></a><span class="cell-sub">{e(r["model"])}</span></td><td class="numeric">${fmt(r.get("priceMonthly"),2)}/mo</td><td class="numeric">{fmt(r["intelligenceIndex"])}</td><td class="numeric">${fmt(r.get("subscriptionUsdPerIntelligencePoint"),4)}</td><td>{badge(r.get("planCalculationStatus") or "partial")}</td><td>{e(r.get("planValueDisplay") or "Provider-hidden allowance")}</td></tr>' for r in plan_access)
    best_task = sorted(subscription_task_estimates, key=lambda r: r.get("subscriptionUsdPerExpectedPass") or math.inf)[:12]
    task_rows = "".join(f'<tr><td><a href="/plans/{e(r["planId"])}/"><strong>{e(r["provider"])} · {e(r["plan"])}</strong></a><span class="cell-sub">{e(r["model"])}</span></td><td class="numeric">{fmt(r["score"])}</td><td class="numeric">{fmt(r["estimatedAttemptsPerAverageMonth"])}</td><td class="numeric">{fmt(r["expectedBenchmarkPassesPerAverageMonth"])}</td><td class="numeric"><strong>${fmt(r.get("subscriptionUsdPerExpectedPass"),4)}</strong></td></tr>' for r in best_task)
    body = f'''<section class="page-intro"><p class="eyebrow">No arbitrary master score</p><h1>Leaders depend on which compromise you'll accept.</h1><p class="lede">Each table is a Pareto frontier: a row survives only when no imported alternative is at least as strong on quality and at least as good on the selected economic or performance axis.</p></section>
<section class="section compact"><div class="frontier-grid"><article class="panel"><div class="panel-header"><div><h3>Coding quality vs API cost/task</h3><p>Artificial Analysis Coding Agent Index</p></div></div><div class="table-shell"><table><thead><tr><th>Configuration</th><th>Index</th><th>$/task</th><th>$/expected pass</th></tr></thead><tbody>{cost_rows}</tbody></table></div></article><article class="panel"><div class="panel-header"><div><h3>Coding quality vs wall time</h3><p>Faster matters only when the task still passes.</p></div></div><div class="table-shell"><table><thead><tr><th>Configuration</th><th>Index</th><th>Time/task</th><th>Minutes/expected pass</th></tr></thead><tbody>{time_rows}</tbody></table></div></article></div></section>
<section class="section"><div class="section-heading"><div><p class="section-kicker">Context efficiency</p><h2>Coding quality versus raw tokens per task</h2></div><p>Raw-token efficiency captures context and agent-turn behavior; it is separate from dollar cost because cache rates and output prices differ.</p></div><div class="panel"><div class="table-shell"><table><thead><tr><th>Configuration</th><th>Index</th><th>Raw tokens/task</th><th>Raw tokens/expected pass</th><th>Cache share</th></tr></thead><tbody>{token_rows}</tbody></table></div></div></section>
<section class="section"><div class="section-heading"><div><p class="section-kicker">Model economics</p><h2>Intelligence versus blended token price</h2></div><p>Dollars per Intelligence Index point is a cost-density signal, not a task-success probability.</p></div><div class="panel"><div class="table-shell"><table><thead><tr><th>Model</th><th>Intelligence</th><th>7:2:1 blended $/M</th><th>$/M/intelligence point</th><th>Output speed</th></tr></thead><tbody>{model_price_rows}</tbody></table></div></div></section>
<section class="section"><div class="section-heading"><div><p class="section-kicker">Latency frontier</p><h2>Intelligence versus output speed</h2></div><p>A cheap model can still be operationally poor if it is slow, while a fast model can be insufficiently capable.</p></div><div class="panel"><div class="table-shell"><table><thead><tr><th>Model</th><th>Intelligence</th><th>Output speed</th><th>Blended $/M</th></tr></thead><tbody>{model_speed_rows}</tbody></table></div></div></section>
