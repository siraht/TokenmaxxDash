        id=id_, provider_id="ozore", provider="Ozore", name=name, price=price, price_display=f"${price}/mo",
        status="exact", confidence="high", allowance_type="dollar-denominated model credits",
        headline=f"${credit} monthly model credits spent at Ozore's published discounted token rates.",
        sources_=["ozore-pricing-2026"],
        models=["GPT-5.6 Sol", "Claude Opus 4.8", "Gemini 3.6 Flash", "GLM-5.2", "DeepSeek V4 Pro", "MiniMax M3", "MiMo V2.5 Pro", "Grok 4.5", "Hy3"],
        unit="USD model credit", plan_units=credit, quotas={"monthlyModelCreditsUsd": credit},
        formula="included model-credit value / recurring subscription price",
        value_display=f"{credit/price:g}×", value_multiple=credit/price, included_value=credit,
        details={"monthlyCreditsExpire": True, "topUpCreditsExpire": False, "maximumAdvertisedDiscountPercent": 35},
        eligibility="api-and-coding-tools",
        workload_eligibility={"interactiveCoding": True, "unattendedAutomation": True, "applicationBackend": True},
    ))

