---
import Nav from '../components/Nav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = 'Compare monthly AI coding subscriptions by effective tokens, external model intelligence, and cost per successful benchmark task.',
  canonical
} = Astro.props;
const pageTitle = title === 'Tokenmaxx' ? title : `${title} · Tokenmaxx`;
const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site || Astro.url.origin).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d10" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="page-shell">
      <Nav />
      <main><slot /></main>
      <footer class="site-footer">
        <p>Snapshot: 18 August 2026. Default view excludes the owner’s Codex, Grok, and Synthetic subscriptions.</p>
        <div>
          <a href="/data/buyer-guide.json">Download data</a>
          <a href="/methodology">Calculation math</a>
          <a href="https://github.com/siraht/TokenmaxxDash">GitHub</a>
        </div>
      </footer>
    </div>
    <script src="/app.js" defer></script>
  </body>
</html>
