---
import BaseLayout from '../layouts/BaseLayout.astro';
import plans from '../data/plans.json';
import benchmarks from '../data/benchmarks.json';
import leaders from '../data/leaders.json';
import summary from '../data/summary.json';
import taskEstimates from '../data/subscription-task-estimates.json';
import { formatNumber, statusLabel } from '../lib/format';

const benchmarkById = new Map(benchmarks.map((row) => [row.id, row]));
const taskById = new Map(taskEstimates.map((row) => [row.id, row]));
const planById = new Map(plans.map((row) => [row.id, row]));

const nativeBudgetFront = (leaders.subscriptionTaskBudgetParetoByQualityFloor?.frontier || [])
  .map((id) => taskById.get(id))
  .filter(Boolean)
  .sort((a, b) => b.score - a.score || a.priceMonthly - b.priceMonthly || a.subscriptionUsdPerExpectedPassHigh - b.subscriptionUsdPerExpectedPassHigh)
  .slice(0, 12);

const costQualityFront = (leaders.codingAgentCostQualityPareto || [])
  .map((id) => benchmarkById.get(id))
  .filter(Boolean)
  .sort((a, b) => b.score - a.score);

const fableAgent = benchmarkById.get('aa-agent-claude-code-fable-5-max-fallback');
const fableModel = benchmarkById.get('aa-model-claude-fable-5-max');
const fableTerminal = benchmarkById.get('terminal-bench-2-1-claude-code-fable-5-xhigh');

const claudePlans = ['claude-code-pro', 'claude-code-max-5x', 'claude-code-max-20x']
  .map((id) => planById.get(id))
  .filter(Boolean);

const rawAllowanceLeaders = (leaders.rawSubsidyLeaders || [])
  .map((id) => planById.get(id))
  .filter(Boolean)
  .slice(0, 8);
---
<BaseLayout title="Tokenmaxx">
  <section class="hero">
    <div>
      <p class="eyebrow">Coding-plan economics, quality first</p>
      <h1>Buy successful work, not impressive-looking token totals.</h1>
      <p class="lede">Tokenmaxx joins externally measured model intelligence and native-agent performance to each plan’s published or inferred allowance. Raw subsidy remains visible, but it can’t outrank a stronger model merely by selling more cheap tokens.</p>
      <div class="hero-actions">
        <a class="button primary" href="/leaders">Explore quality-gated leaders</a>
        <a class="button" href="/models">Compare every model route</a>
        <a class="button subtle" href="/plans">Inspect every plan</a>
      </div>
    </div>
    <aside class="verdict-card">
      <p class="section-kicker">Default comparison gate</p>
      <strong>≥60</strong>
      <span>direct external model-intelligence score</span>
      <p>Below this line, a plan can still lead a low-cost or high-volume frontier, but it won’t displace frontier-quality routes in the default recommendation surface.</p>
    </aside>
  </section>

  <section class="section compact" aria-label="Catalog summary">
    <div class="kpi-grid">
      <article class="kpi-card"><strong>{summary.planCount}</strong><span>subscription tiers cataloged</span></article>
      <article class="kpi-card"><strong>{summary.modelRouteCount}</strong><span>advertised model labels resolved</span></article>
      <article class="kpi-card"><strong>{summary.directBenchmarkModelRouteCount}</strong><span>labels with direct external evidence</span></article>
      <article class="kpi-card"><strong>{summary.subscriptionTaskEstimateCount}</strong><span>native plan/task joins calculated</span></article>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div><p class="section-kicker">Native subscription economics</p><h2>The default frontier now includes Claude Code and Codex.</h2></div>
      <p>These rows require a native external agent result, a directly matched model route, and a quantified subscription denominator. The quality floor is 60, so raw allowance alone cannot enter.</p>
    </div>
    <div class="panel">
      <div class="table-shell"><table>
        <thead><tr><th>Plan / tested route</th><th>Agent index</th><th>Price</th><th>Expected passes/month</th><th>Subscription $/expected pass</th><th>Evidence</th></tr></thead>
        <tbody>{nativeBudgetFront.map((row) => (
          <tr>
            <td><a href={`/plans/${row.planId}`}><strong>{row.provider} · {row.plan}</strong></a><span class="cell-sub">{row.agent} · {row.benchmarkModel}</span></td>
            <td class="numeric"><strong>{row.score}</strong></td>
            <td class="numeric">${row.priceMonthly}/mo</td>
            <td class="numeric">{formatNumber(row.expectedBenchmarkPassesPerAverageMonthLow)}–{formatNumber(row.expectedBenchmarkPassesPerAverageMonthHigh)}</td>
            <td class="numeric"><strong>${row.subscriptionUsdPerExpectedPassLow.toFixed(3)}–${row.subscriptionUsdPerExpectedPassHigh.toFixed(3)}</strong></td>
            <td><span class={`badge ${row.evidenceConfidence}`}>{row.evidenceConfidence}</span><span class="cell-sub">API-cost counterfactual mapped into the measured or published plan pool</span></td>
          </tr>
        ))}</tbody>
      </table></div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div><p class="section-kicker">Previously missing</p><h2>Fable 5 is now a first-class model and native-agent route.</h2></div>
      <p>Its model score, Claude Code score, Terminal-Bench result, API pricing, subscription access mode, and Max-only 50% weekly-meter ceiling are tracked separately.</p>
    </div>
    <div class="fable-grid">
      <article class="feature-card purple">
        <span class="feature-label">Model intelligence</span>
        <strong>{fableModel?.score ?? '—'}</strong>
        <h3>Claude Fable 5 · max</h3>
        <p>{fableModel ? `$${fableModel.blendedPricePerMUsd.toFixed(2)}/M under the 7:2:1 external pricing convention, ${fableModel.outputTokensPerSecond.toFixed(1)} output tok/s.` : 'External model row unavailable.'}</p>
      </article>
      <article class="feature-card purple">
        <span class="feature-label">Native coding agent</span>
        <strong>{fableAgent?.score ?? '—'}</strong>
        <h3>Claude Code · Fable 5</h3>
        <p>{fableAgent ? `$${fableAgent.apiCostPerTaskUsd.toFixed(2)} API-priced cost/task and ${fableAgent.timePerTaskMinutes.toFixed(1)} minutes/task in the imported Coding Agent Index.` : 'External agent row unavailable.'}</p>
      </article>
      <article class="feature-card purple">
        <span class="feature-label">Terminal-Bench 2.1</span>
        <strong>{fableTerminal ? `${fableTerminal.score}%` : '—'}</strong>
        <h3>Claude Code · Fable 5 xhigh</h3>
        <p>Max includes Fable inside the shared quota but caps it at 50% of the weekly meter. Pro starts Fable on PAYG credits, so it receives no fake included-token estimate.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div><p class="section-kicker">Claude Code allowance inference</p><h2>All three plans now have calculated token-cost ranges.</h2></div>
      <p>Raw tokens come from ccusage/dashboard measurements; API-equivalent ranges come from observed weekly burn. Both are workload-dependent because Anthropic keeps the meter weights hidden.</p>
    </div>
    <div class="panel"><div class="table-shell"><table>
      <thead><tr><th>Claude plan</th><th>Measured raw tokens/week</th><th>Average raw tokens/month</th><th>Full-utilization subscription $/M raw</th><th>Measured API-equivalent/month</th><th>Value multiple</th></tr></thead>
      <tbody>{claudePlans.map((plan) => (
        <tr>
          <td><a href={`/plans/${plan.id}`}><strong>{plan.name}</strong></a><span class="cell-sub">${plan.priceMonthly}/mo · shared Claude + Code limits</span></td>
          <td class="numeric">{plan.quotas.weeklyRawTokensBillionLow.toFixed(2)}–{plan.quotas.weeklyRawTokensBillionHigh.toFixed(2)}B</td>
          <td class="numeric">{plan.quotas.averageMonthlyRawTokensBillionLow.toFixed(2)}–{plan.quotas.averageMonthlyRawTokensBillionHigh.toFixed(2)}B</td>
          <td class="numeric"><strong>${plan.quotas.subscriptionUsdPerMillionRawTokensLow.toFixed(4)}–${plan.quotas.subscriptionUsdPerMillionRawTokensHigh.toFixed(4)}</strong></td>
          <td class="numeric">${formatNumber(plan.quotas.averageMonthlyApiEquivalentUsdLow)}–${formatNumber(plan.quotas.averageMonthlyApiEquivalentUsdHigh)}</td>
          <td class="numeric">{plan.valueMultipleLow.toFixed(2)}–{plan.valueMultipleHigh.toFixed(2)}×</td>
        </tr>
      ))}</tbody>
    </table></div></div>
    <div class="callout warning" style="margin-top:14px"><strong>These are measured ranges, not official token allowances.</strong> Each Claude plan page now also calculates pure-category estimates for Opus 5, Fable 5, Sonnet 5, and Haiku 4.5 across uncached input, cache reads, cache writes, and output.</div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div><p class="section-kicker">External agent economics</p><h2>Quality versus API cost per expected pass</h2></div>
      <p>This Pareto front is independent of subscriptions. It answers which externally tested agent configurations trade quality for provider-priced task cost most efficiently.</p>
    </div>
    <div class="panel"><div class="table-shell"><table>
      <thead><tr><th>Agent / model</th><th>Index</th><th>API cost/task</th><th>API $/expected pass</th><th>Time/task</th></tr></thead>
      <tbody>{costQualityFront.map((row) => (
        <tr>
          <td><strong>{row.agent}</strong><span class="cell-sub">{row.model}</span></td>
          <td class="numeric">{row.score}</td>
          <td class="numeric">${row.apiCostPerTaskUsd?.toFixed(2)}</td>
          <td class="numeric"><strong>${row.apiUsdPerExpectedPass?.toFixed(3)}</strong></td>
          <td class="numeric">{row.timePerTaskMinutes?.toFixed(1)}m</td>
        </tr>
      ))}</tbody>
    </table></div></div>
  </section>

  <section class="section compact">
    <div class="section-heading"><div><p class="section-kicker">Raw allowance, deliberately last</p><h2>Large pools remain useful evidence, not a universal ranking.</h2></div><a class="button subtle" href="/plans">Inspect every denominator</a></div>
    <div class="raw-leader-strip">{rawAllowanceLeaders.map((plan) => (
      <a class="raw-leader" href={`/plans/${plan.id}`}><strong>{plan.valueDisplay}</strong><span>{plan.provider} · {plan.name}</span><small>{statusLabel(plan.calculationStatus)}</small></a>
    ))}</div>
  </section>
</BaseLayout>
