        allowance_type="daily agent-task quota", headline=f"{tasks_day} agent tasks/day with {concurrent} concurrent tasks.",
        sources_=["jules-limits"], formula="monthly task ceiling depends on calendar days; daily quota and concurrency bind independently",
        quotas={"dailyTasks": tasks_day, "concurrentTasks": concurrent, "thirtyDayTaskCeiling": tasks_day * 30},
        models=["Jules managed coding agent"], notes=["A Jules task is a managed agent job, not a model request or token unit."], unit="agent task", plan_units=tasks_day * 30,
    ))
for name, price, tokens_m, daily_m, rollover in [
