    upsert(sources, source)
source_by_id = {source["id"]: source for source in sources}

# ---------------------------------------------------------------------------
# Current external benchmarks
# ---------------------------------------------------------------------------
# Retain old coding-agent variants that remain part of the current v1.3 table,
# but replace model-intelligence and Terminal-Bench snapshots with current rows.
benchmarks = [
    b for b in base_benchmarks
    if b.get("kind") == "coding-agent"
    and b.get("benchmark") == "Artificial Analysis Coding Agent Index"
]

# Correct legacy $/expected-pass derived fields and attach Pareto flags later.
for row in benchmarks:
    score = row.get("score")
    cost = row.get("apiCostPerTaskUsd")
    time = row.get("timePerTaskMinutes")
    tokens = row.get("tokensPerTaskM")
    if score:
        pass_rate = score / 100
        row["apiUsdPerExpectedPass"] = round(cost / pass_rate, 6) if cost is not None else None
        row["expectedPassesPerApiDollar"] = round(pass_rate / cost, 6) if cost else None
        row["minutesPerExpectedPass"] = round(time / pass_rate, 6) if time is not None else None
        row["tokensPerExpectedPassM"] = round(tokens / pass_rate, 6) if tokens is not None else None
    row["retrievedAt"] = AS_OF

# Current rows not present in the base catalog.
