#!/usr/bin/env python3
"""Post-process the generated market snapshot with current primary-source corrections,
external benchmark economics, canonical model coverage, and Pareto frontiers.

This script deliberately does not crawl or benchmark. It turns reviewed source facts into
versioned, deterministic JSON consumed by both Astro and the dependency-free static build.
"""
from __future__ import annotations

import json
import math
import re
from copy import deepcopy
from pathlib import Path
from typing import Any, Iterable

ROOT = Path(__file__).resolve().parents[1]
DATA = ROOT / "src" / "data"
PUBLIC_DATA = ROOT / "public" / "data"
AS_OF = "2026-08-17"
AVG_WEEKS_PER_MONTH = 365.2425 / 12 / 7


def read(name: str) -> Any:
    return json.loads((DATA / name).read_text(encoding="utf-8"))


def write(name: str, value: Any) -> None:
    text = json.dumps(value, ensure_ascii=False, indent=2) + "\n"
    (DATA / name).write_text(text, encoding="utf-8")
    PUBLIC_DATA.mkdir(parents=True, exist_ok=True)
    (PUBLIC_DATA / name).write_text(text, encoding="utf-8")


plans: list[dict[str, Any]] = read("plans.json")
benchmarks: list[dict[str, Any]] = read("benchmarks.json")
sources: list[dict[str, Any]] = read("sources.json")
methodology: dict[str, Any] = read("methodology.json")


def add_source(source: dict[str, Any]) -> None:
    existing = {row["id"]: row for row in sources}
    if source["id"] in existing:
        existing[source["id"]].update(source)
    else:
        sources.append(source)


