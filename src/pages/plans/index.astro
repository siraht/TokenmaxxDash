---
import BaseLayout from '../../layouts/BaseLayout.astro';
import guide from '../../data/buyer-guide.json';
const providers = [...new Set(guide.planSummaries.map((plan) => plan.provider))].sort();
const money = (value) => typeof value === 'number' ? `$${value.toFixed(value < .01 ? 5 : 3)}` : '—';
---
<BaseLayout title="All monthly plans" description="Every researched monthly AI coding subscription, including token pools, request plans, managed agents, relative tiers, and provider-hidden quotas.">
  <section class="page-intro"><p class="eyebrow">Complete monthly catalog</p><h1>Every plan stays visible, even when the provider hides the number that would make it comparable.</h1><p class="lede">Token-comparable plans receive $/token and quality-adjusted metrics. Request and managed products keep their native units. Provider-hidden plans state the exact missing allowance, model multiplier, or task conversion.</p></section>
  <section class="section compact">
    <div class="toolbar">
      <div class="control"><label for="plan-search">Search</label><input id="plan-search" data-plan-search type="search" placeholder="Provider or plan…" /></div>
      <div class="control"><label for="plan-provider">Provider</label><select id="plan-provider" data-plan-provider><option value="all">All providers</option>{providers.map((provider) => <option value={provider}>{provider}</option>)}</select></div>
      <div class="control"><label for="plan-evidence">Evidence</label><select id="plan-evidence" data-plan-evidence><option value="all">All evidence</option><option value="primary">Official + measured</option><option value="official">Official only</option><option value="secondary">Secondary / hidden</option></select></div>
      <div class="control"><label for="plan-quantified">Comparison</label><select id="plan-quantified" data-plan-quantified><option value="all">All plans</option><option value="yes">Token or request comparable</option><option value="no">Managed, relative, or hidden</option></select></div>
      <div class="control"><label for="plan-sort">Sort</label><select id="plan-sort" data-plan-sort><option value="provider">Provider</option><option value="price">Price</option><option value="quality-cost">Best quality-adjusted token cost</option></select></div>
    </div>
    <div class="results-line"><span data-plan-count>{guide.planSummaries.length} plans</span><span>{guide.summary.unquantifiedPlanCount} currently lack a defensible token or request denominator.</span></div>
  </section>
  <section class="section compact"><div class="plan-grid" data-plan-grid>{guide.planSummaries.map((plan) => (
    <a class="plan-card" href={`/plans/${plan.id}`} data-plan-card data-search={`${plan.provider} ${plan.plan} ${plan.comparisonClass} ${plan.missingFields.join(' ')}`.toLowerCase()} data-provider={plan.provider} data-confidence={plan.confidence} data-quantified={plan.tokenRouteCount || plan.requestRouteCount ? 'yes' : 'no'} data-price={plan.priceUsd} data-quality-cost={plan.bestAgenticQualityCost ?? 999999}>
      <div class="topline"><div><strong>{plan.provider}</strong><span class="cell-sub">{plan.plan}</span></div><span class="price">${plan.priceUsd.toFixed(2)}</span></div>
      <p>{plan.comparisonClass} · {plan.researchStatus} {plan.owned ? '· owned baseline' : ''}</p>
      <div class="best"><strong>{plan.bestAgenticModel || plan.allowanceKind}</strong><span class="cell-sub">{plan.bestAgenticQualityCost != null ? `${money(plan.bestAgenticQualityCost)} quality-adjusted $/M` : plan.missingFields.slice(0, 3).join(' · ')}</span></div>
    </a>
  ))}</div><div class="empty-state" data-plan-empty>No plan matches those filters.</div></section>
</BaseLayout>
