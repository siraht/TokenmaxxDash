
add_catalog("Tabnine", [("Code Assistant", 39), ("Agentic Platform", 59)], provider_id="tabnine", category="team-coding-subscription",
            headline="Subscription price is known, but included inference volume is not; model access is described as cost plus a service margin.",
            allowance_type="opaque enterprise inference allowance", sources_=["codingplans-cc"])
add_catalog("AI Router", [("Developer", 10), ("Pro", 30), ("Max", 100)], provider_id="ai-router",
            headline="Multi-model routing subscription discovered; current model-credit pool and deduction table require primary verification.",
            allowance_type="multi-model credits", sources_=["codingplans-cc"])
add_catalog("Fireworks Fire Pass", [("Developer", 20), ("Power", 100)], provider_id="fireworks-fire-pass",
            headline="Flat-rate inference product discovered; current model eligibility, throughput and fair-use envelope remain unresolved.",
            allowance_type="fair-use inference access", sources_=["codingplans-cc"])

# JetBrains, Replit and Augment transparent dollar denominators.
for name, price, credits in [("AI Pro", 10, 10), ("AI Ultimate", 30, 35), ("Organization Pro", 20, 20), ("Organization Ultimate", 60, 70)]:
    plans.append(make_plan(
        "JetBrains AI", name, price, provider_id="jetbrains-ai", calculation_status="exact", confidence="medium",
        allowance_type="AI credits", headline=f"{credits} AI Credits/month; JetBrains defines one credit as $1.", sources_=["tokenplans"],
        value_multiple=q(Decimal(credits)/Decimal(price), "0.001"), included_value_usd=credits,
        formula="1 AI Credit = $1 of usage", quotas={"monthlyAiCredits": credits}, unit="JetBrains AI Credit", plan_units=credits,
    ))
for name, price, credits, concurrency in [("Core", 25, 25, 2), ("Pro", 100, 100, 10)]:
    plans.append(make_plan(
        "Replit", name, price, provider_id="replit", calculation_status="exact", confidence="medium",
        allowance_type="platform credits", headline=f"${credits} platform credits/month and up to {concurrency} parallel agents.", sources_=["tokenplans"],
        value_multiple=1.0, included_value_usd=credits, formula="platform credits deplete according to Replit service pricing",
        quotas={"monthlyCreditsUsd": credits, "parallelAgents": concurrency}, unit="Replit platform USD", plan_units=credits,
    ))
plans.append(make_plan(
    "Augment Code", "Business", 100, provider_id="augment-code", category="team-coding-subscription",
    calculation_status="exact", confidence="medium", allowance_type="usage allowance with service fee",
    headline="$100 usage allowance; model inference is API list price plus a 40% service fee, so at most $71.43 is raw model-list value.",
    sources_=["tokenplans"], value_multiple=q(Decimal("71.4286")/Decimal("100"), "0.001"), included_value_usd=71.43,
    formula="raw model-list value = allowance / 1.4 when all usage is LLM inference",
    quotas={"monthlyAllowanceUsd": 100, "serviceFee": 0.4}, unit="Augment usage USD", plan_units=100,
))

# Ensure unique IDs and stable ordering.
seen: set[str] = set()
for plan in plans:
    if plan["id"] in seen:
        raise ValueError(f"duplicate plan id: {plan['id']}")
    seen.add(plan["id"])

plans.sort(key=lambda p: (p["provider"].lower(), (p["priceMonthly"] is None), p["priceMonthly"] or 0, p["name"].lower()))

# ---- External benchmark data only; no first-party benchmark results are invented. ----
benchmarks: list[dict[str, Any]] = []

def add_agent_benchmark(agent: str, model: str, index: float, deep: float | None, terminal: float | None,
                        qna: float | None, cost: float | None, time_m: float | None, tokens_m: float | None,
                        source_id: str, cache_hit: float | None = None, turns: float | None = None) -> None:
    benchmarks.append({
        "id": slug(f"aa-agent-{agent}-{model}"), "kind": "coding-agent", "benchmark": "Artificial Analysis Coding Agent Index",
        "version": "v1.3", "agent": agent, "model": model, "score": index,
        "deepSWE": deep, "terminalBenchV2": terminal, "sweAtlasQnA": qna,
        "apiCostPerTaskUsd": cost, "timePerTaskMinutes": time_m, "tokensPerTaskM": tokens_m,
        "cacheHitRate": cache_hit, "turnsPerTask": turns, "sourceId": source_id, "retrievedAt": AS_OF,
        "costMeaning": "Pay-per-token API cost, not subscription allocation.",
    })

