"""Normalized monthly plan definitions plus broad-catalog supplementation."""
from __future__ import annotations

import json
from pathlib import Path
from typing import Any

from .models import (
    EUR_USD, WEEKS_PER_MONTH, MODELS, TOP_CATALOG, OPEN_CATALOG,
    OPEN_CODE_RATES, OPEN_CODE_USAGE, COMMAND_RATES, COMMAND_GO_MODELS,
    COMMAND_GOAT_MODELS, COMMAND_PRO_MODELS, COMMAND_MAX_MODELS,
)

ROOT = Path(__file__).resolve().parents[2]
DATA = ROOT / "src" / "data"

# Plan definitions focus on individual monthly coding/inference subscriptions. Team-only,
# app-builder, and enterprise products remain in the broad catalog generated by build_data.py,
# but do not clutter the purchasing table.
PLANS: list[dict[str, Any]] = []

def add(provider: str, plan: str, price: float, *, id: str, models: list[str], allowance: dict[str, Any],
        source: str, confidence: str = "official", owned: bool = False, windows: str | None = None,
        policy: str = "unknown", note: str | None = None, currency: str = "USD", originalPrice: float | None = None,
        routeRates: dict[str, dict[str, float]] | None = None,
        monthlyUsdByModel: dict[str, float] | None = None,
        routeNotes: dict[str, str] | None = None,
        supplemental: bool = False) -> None:
    PLANS.append({
        "id": id, "provider": provider, "plan": plan, "priceUsd": round(price, 4), "models": models,
        "allowance": allowance, "source": source, "confidence": confidence, "owned": owned,
        "windows": windows, "policy": policy, "note": note, "currency": currency,
        "originalPrice": originalPrice if originalPrice is not None else price,
        "routeRates": routeRates or {}, "monthlyUsdByModel": monthlyUsdByModel or {},
        "routeNotes": routeNotes or {}, "supplemental": supplemental,
    })

# Transparent provider-rate dollar pools.
add(
    "OpenCode Go", "Go", 10, id="opencode-go",
    models=["grok-4.5", "gpt-5.6-luna", "glm-5.3", "glm-5.2", "kimi-k3", "kimi-k2.7-code", "kimi-k2.6", "mimo-v2.5", "mimo-v2.5-pro", "minimax-m3", "qwen3.8-max", "qwen3.7-max", "qwen3.7-plus", "qwen3.6-plus", "deepseek-v4-pro", "deepseek-v4-flash", "hy3"],
