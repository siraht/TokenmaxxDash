---
import BaseLayout from '../../layouts/BaseLayout.astro';
import guide from '../../data/buyer-guide.json';

export function getStaticPaths() {
  return guide.plans.map((plan) => ({ params: { id: plan.id }, props: { plan } }));
}
const { plan } = Astro.props;
const summary = guide.planSummaries.find((row) => row.id === plan.id);
const routes = guide.rows.filter((row) => row.planId === plan.id).sort((a, b) => (a.agentic.qualityAdjustedUsdPerM ?? Infinity) - (b.agentic.qualityAdjustedUsdPerM ?? Infinity));
const requests = guide.requestRows.filter((row) => row.planId === plan.id);
const money = (value) => typeof value === 'number' ? `$${value.toFixed(value < .01 ? 5 : 3)}` : '—';
const number = (value, digits = 2) => typeof value === 'number' ? value.toLocaleString('en-US', { maximumFractionDigits: digits }) : '—';
---
<BaseLayout title={`${plan.provider} ${plan.plan}`} description={`Subscription economics and evidence for ${plan.provider} ${plan.plan}.`}>
  <section class="detail-hero"><div><p class="eyebrow">{summary.comparisonClass} plan</p><h1>{plan.provider} · {plan.plan}</h1><p class="lede">{plan.note || plan.windows || 'Monthly coding subscription.'}</p></div><div class="price-block"><strong>${plan.priceUsd.toFixed(2)}</strong><span>per month</span>{plan.owned && <span class="badge owned" style="margin-top:8px">Owned baseline</span>}</div></section>

  <section class="panel"><div class="panel-header"><div><h3>Plan denominator</h3><p>{plan.researchStatus} · {plan.confidence}</p></div><a href={plan.source} target="_blank" rel="noreferrer">Source ↗</a></div><div class="panel-body">
    <dl class="definition-grid">
      <div class="definition"><dt>Comparison class</dt><dd>{plan.comparisonClass}</dd></div><div class="definition"><dt>Allowance kind</dt><dd>{plan.allowance.kind}</dd></div><div class="definition"><dt>Token routes</dt><dd>{routes.length}</dd></div><div class="definition"><dt>Request routes</dt><dd>{requests.length}</dd></div><div class="definition"><dt>Rate windows</dt><dd>{plan.windows || 'No separate window published'}</dd></div><div class="definition"><dt>Policy</dt><dd>{plan.policy}</dd></div>
    </dl><pre class="formula" style="margin-top:14px">{JSON.stringify(plan.allowance, null, 2)}</pre>
  </div></section>

  {plan.missingFields?.length > 0 && <section class="section compact"><div class="callout warning"><strong>Still missing from the provider’s public evidence:</strong> {plan.missingFields.join(' · ')}</div></section>}

  {routes.length > 0 && <section class="section"><div class="section-heading"><div><p class="section-kicker">Token-comparable routes</p><h2>Every served model with a defensible rate</h2></div><p>Agentic high-cache values are shown; the downloadable data also contains standardized 7:2:1.</p></div><div class="panel"><div class="table-shell"><table>
    <thead><tr><th>Model</th><th>Access</th><th>Intelligence</th><th>Coding</th><th>API $/M</th><th>Raw tokens/month</th><th>Subscription $/M</th><th>Quality-adjusted $/M</th><th>$/successful task</th></tr></thead>
    <tbody>{routes.map((row) => (
      <tr><td><strong>{row.model}</strong><span class="cell-sub">{row.modelProvider}</span></td><td>{row.accessMode || 'included'}{row.allowanceFraction !== 1 && <span class="cell-sub">{(row.allowanceFraction * 100).toFixed(0)}% maximum allowance share</span>}</td><td class="numeric">{row.intelligence?.toFixed(1) ?? '—'}</td><td class="numeric">{row.codingScore?.toFixed(1) ?? '—'}</td><td class="numeric">{money(row.agentic.apiRatePerM)}</td><td class="numeric">{number(row.agentic.monthlyTokensM, 1)}M</td><td class="numeric">{money(row.agentic.subscriptionUsdPerM)}</td><td class="numeric"><strong>{money(row.agentic.qualityAdjustedUsdPerM)}</strong></td><td class="numeric">{money(row.agentic.subscriptionUsdPerSuccessfulTask)}</td></tr>
    ))}</tbody>
  </table></div></div></section>}

  {requests.length > 0 && <section class="section"><div class="section-heading"><div><p class="section-kicker">Request-denominated routes</p><h2>Native request economics</h2></div><p>These plans publish request weights but not enough information to turn each request into a stable token count.</p></div><div class="panel"><div class="table-shell"><table><thead><tr><th>Model</th><th>Monthly requests</th><th>$/1,000 requests</th><th>Quality-adjusted $/1,000</th></tr></thead><tbody>{requests.map((row) => <tr><td><strong>{row.model}</strong></td><td class="numeric">{number(row.standard.monthlyRequests, 0)}</td><td class="numeric">{money(row.standard.usdPer1000Requests)}</td><td class="numeric">{money(row.standard.qualityAdjustedUsdPer1000Requests)}</td></tr>)}</tbody></table></div></div></section>}

  <section class="section compact"><a href="/plans">← Back to every plan</a></section>
</BaseLayout>
