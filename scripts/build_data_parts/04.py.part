        quotas={"fiveHourUsd": five_h, "weeklyUsd": weekly_value, "monthlyUsd": monthly_value},
        models=[r["model"] for r in command_rates],
        notes=[
            "Some models have plan-specific monthly subcaps, so the headline credit pool is an upper bound for that model.",
