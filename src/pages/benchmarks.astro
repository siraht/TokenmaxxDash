---
import BaseLayout from '../layouts/BaseLayout.astro';
import benchmarks from '../data/benchmarks.json';
import sources from '../data/sources.json';

const agentRows = benchmarks
  .filter((row) => row.benchmark === 'Artificial Analysis Coding Agent Index')
  .sort((a, b) => b.score - a.score || (a.apiUsdPerExpectedPass ?? Infinity) - (b.apiUsdPerExpectedPass ?? Infinity));
const modelRows = benchmarks
  .filter((row) => row.kind === 'model-intelligence')
  .sort((a, b) => b.score - a.score);
const terminalRows = benchmarks
  .filter((row) => row.benchmark === 'Terminal-Bench')
  .sort((a, b) => b.score - a.score);
const cursorBenchRows = benchmarks
  .filter((row) => row.benchmark === 'CursorBench')
  .sort((a, b) => b.score - a.score || (a.apiUsdPerExpectedPass ?? Infinity) - (b.apiUsdPerExpectedPass ?? Infinity));
const agents = [...new Set(agentRows.map((row) => row.agent))].sort();
const sourceMap = new Map(sources.map((source) => [source.id, source]));
const fableRows = benchmarks.filter((row) => row.model?.toLowerCase().includes('fable'));
const fableAgent = fableRows.find((row) => row.id === 'aa-agent-claude-code-fable-5-max-fallback');
const fableModel = fableRows.find((row) => row.id === 'aa-model-claude-fable-5-max');
const fableTerminal = fableRows.find((row) => row.id === 'terminal-bench-2-1-claude-code-fable-5-xhigh');

const costRows = agentRows.filter((row) => row.apiCostPerTaskUsd > 0);
const width = 900;
const height = 440;
const margin = { left: 58, right: 24, top: 28, bottom: 48 };
const minCost = Math.min(...costRows.map((row) => row.apiCostPerTaskUsd)) * 0.75;
const maxCost = Math.max(...costRows.map((row) => row.apiCostPerTaskUsd)) * 1.2;
const minScore = Math.floor(Math.min(...costRows.map((row) => row.score)) / 10) * 10;
const maxScore = Math.ceil(Math.max(...costRows.map((row) => row.score)) / 10) * 10;
const x = (cost) => margin.left + ((Math.log10(cost) - Math.log10(minCost)) / (Math.log10(maxCost) - Math.log10(minCost))) * (width - margin.left - margin.right);
const y = (score) => margin.top + (1 - (score - minScore) / (maxScore - minScore)) * (height - margin.top - margin.bottom);
const costTicks = [0.04, 0.1, 0.3, 1, 3, 10].filter((tick) => tick >= minCost && tick <= maxCost);
const scoreTicks = Array.from({ length: Math.floor((maxScore - minScore) / 10) + 1 }, (_, index) => minScore + index * 10);
const labelPoint = (row) => [
  'GPT-5.6 Sol (max)', 'GPT-5.6 Terra (max)', 'GPT-5.6 Luna (max)',
  'DeepSeek V4 Flash (max)', 'Opus 5 (xhigh)', 'Fable 5 (max, with fallback)',
  'Kimi K3', 'Composer 2.5'
].includes(row.model);
const className = (agent) => agent.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<BaseLayout title="External benchmarks" description="Imported external coding-agent and model-intelligence results with API cost per task, cost per expected pass, normalized token economics, speed and source provenance.">
  <section class="page-intro">
    <p class="eyebrow">External results only</p>
    <h1>Quality stays attached to the exact model, harness, effort, and benchmark.</h1>
    <p class="lede">Tokenmaxx imports publisher-owned results and derives transparent ratios from them. It does not run a private suite, infer scores for untested plan routes, or use a model Intelligence Index as though it were a coding-task pass rate.</p>
  </section>

  <section class="section compact">
    <div class="fable-grid">
      <article class="feature-card purple"><span class="feature-label">Fable 5 model</span><strong>{fableModel?.score ?? '—'}</strong><h3>Artificial Analysis Intelligence Index</h3><p>{fableModel ? `$${fableModel.blendedPricePerMUsd.toFixed(2)}/M normalized blend · ${fableModel.outputTokensPerSecond.toFixed(1)} output tok/s` : 'No direct row.'}</p></article>
      <article class="feature-card purple"><span class="feature-label">Fable 5 native agent</span><strong>{fableAgent?.score ?? '—'}</strong><h3>Claude Code · Coding Agent Index</h3><p>{fableAgent ? `$${fableAgent.apiCostPerTaskUsd.toFixed(2)}/task · $${fableAgent.apiUsdPerExpectedPass.toFixed(2)}/expected pass` : 'No direct row.'}</p></article>
      <article class="feature-card purple"><span class="feature-label">Fable 5 terminal</span><strong>{fableTerminal ? `${fableTerminal.score}%` : '—'}</strong><h3>Claude Code · Terminal-Bench 2.1</h3><p>Tracked separately from the composite Coding Agent Index, with its own version and reported total run cost.</p></article>
    </div>
  </section>

  <section class="section compact">
    <div class="callout"><strong>Cost per expected pass applies only to pass-rate-like agent scores.</strong> It equals API cost per task divided by score/100. Model Intelligence Index rows instead use normalized dollars per million tokens per intelligence point.</div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div><p class="section-kicker">External cost–quality surface</p><h2>Coding Agent Index versus API cost per task</h2></div>
      <p>The horizontal axis is logarithmic. Left is cheaper under the benchmark publisher’s provider-priced token accounting; higher means better composite coding-agent performance.</p>
    </div>
    <div class="panel chart-panel">
      <svg class="scatter" viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="scatter-title scatter-desc">
        <title id="scatter-title">Coding Agent Index versus API cost per task</title>
        <desc id="scatter-desc">External results for Codex, Claude Code, Cursor, Grok Build and Kimi Code configurations.</desc>
        {scoreTicks.map((tick) => <><line class="gridline" x1={margin.left} x2={width - margin.right} y1={y(tick)} y2={y(tick)} /><text class="axis-label" x={margin.left - 10} y={y(tick) + 3} text-anchor="end">{tick}</text></>)}
        {costTicks.map((tick) => <><line class="gridline" y1={margin.top} y2={height - margin.bottom} x1={x(tick)} x2={x(tick)} /><text class="axis-label" x={x(tick)} y={height - 22} text-anchor="middle">${tick}</text></>)}
        <text class="axis-label" x={width / 2} y={height - 5} text-anchor="middle">API cost per task · logarithmic</text>
        <text class="axis-label" transform={`translate(13 ${height/2}) rotate(-90)`} text-anchor="middle">Coding Agent Index</text>
        {costRows.map((row) => (
          <g>
            <circle class={`point ${className(row.agent)}`} cx={x(row.apiCostPerTaskUsd)} cy={y(row.score)} r={labelPoint(row) ? 6.5 : 4.2}><title>{row.agent} · {row.model}: {row.score} index, ${row.apiCostPerTaskUsd}/task</title></circle>
            {labelPoint(row) && <text class="point-label" x={x(row.apiCostPerTaskUsd) + 8} y={y(row.score) - 7}>{row.model.replace('GPT-5.6 ', '')}</text>}
          </g>
        ))}
      </svg>
      <div class="legend"><span>Codex</span><span class="claude">Claude Code</span><span class="cursor">Cursor</span><span class="kimi">Kimi / other</span></div>
    </div>
  </section>

  <section class="section compact">
    <div class="toolbar">
      <div class="control"><label for="benchmark-search">Search benchmark rows</label><input id="benchmark-search" data-benchmark-search type="search" placeholder="Fable, Opus, Sol, Kimi…" /></div>
      <div class="control"><label for="benchmark-agent">Agent</label><select id="benchmark-agent" data-benchmark-agent><option value="all">All agents</option>{agents.map((agent) => <option value={agent}>{agent}</option>)}</select></div>
    </div>
    <div class="panel"><div class="table-shell"><table data-benchmark-table>
      <thead><tr><th>Agent / model</th><th>Index</th><th>DeepSWE</th><th>Terminal</th><th>SWE Atlas</th><th>API cost/task</th><th>API $/expected pass</th><th>Time/task</th><th>Tokens/expected pass</th><th>Pareto</th></tr></thead>
      <tbody>{agentRows.map((row) => (
        <tr data-benchmark-row data-agent={row.agent} data-search={`${row.agent} ${row.model}`.toLowerCase()}>
          <td><strong>{row.agent}</strong><span class="cell-sub">{row.model}</span></td>
          <td class="numeric"><strong>{row.score}</strong></td>
          <td class="numeric">{row.deepSWE ?? '—'}%</td>
          <td class="numeric">{row.terminalBenchV2 ?? '—'}%</td>
          <td class="numeric">{row.sweAtlasQnA ?? '—'}%</td>
          <td class="numeric">{row.apiCostPerTaskUsd != null ? `$${row.apiCostPerTaskUsd.toFixed(2)}` : '—'}</td>
          <td class="numeric">{row.apiUsdPerExpectedPass != null ? `$${row.apiUsdPerExpectedPass.toFixed(3)}` : '—'}</td>
          <td class="numeric">{row.timePerTaskMinutes != null ? `${row.timePerTaskMinutes.toFixed(1)}m` : '—'}</td>
          <td class="numeric">{row.tokensPerExpectedPassM != null ? `${row.tokensPerExpectedPassM.toFixed(2)}M` : '—'}</td>
          <td>{row.costQualityPareto && <span class="pareto-chip">cost</span>} {row.timeQualityPareto && <span class="pareto-chip">time</span>} {row.tokenQualityPareto && <span class="pareto-chip">tokens</span>}</td>
        </tr>
      ))}</tbody>
    </table></div></div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div><p class="section-kicker">Publisher-owned task benchmark</p><h2>CursorBench 3.2</h2></div>
      <p>Cursor publishes pass rate, model API cost, tokens, and agent steps for the same Cursor Agent harness. These rows are kept on their own scale and are not merged into the Artificial Analysis Coding Agent Index.</p>
    </div>
    <div class="panel"><div class="table-shell"><table>
      <thead><tr><th>Cursor Agent model</th><th>Pass rate</th><th>API cost/task</th><th>API $/expected pass</th><th>Tokens/task</th><th>Tokens/expected pass</th><th>Steps/task</th><th>Steps/expected pass</th></tr></thead>
      <tbody>{cursorBenchRows.map((row) => (
        <tr>
          <td><strong>{row.model}</strong><span class="cell-sub">CursorBench {row.version}</span></td>
          <td class="numeric"><strong>{row.score.toFixed(1)}%</strong></td>
          <td class="numeric">${row.apiCostPerTaskUsd.toFixed(2)}</td>
          <td class="numeric"><strong>${row.apiUsdPerExpectedPass.toFixed(3)}</strong></td>
          <td class="numeric">{row.tokensPerTask.toLocaleString()}</td>
          <td class="numeric">{Math.round(row.tokensPerExpectedPass).toLocaleString()}</td>
          <td class="numeric">{row.stepsPerTask}</td>
          <td class="numeric">{row.stepsPerExpectedPass.toFixed(1)}</td>
        </tr>
      ))}</tbody>
    </table></div></div>
    <div class="callout" style="margin-top:14px"><strong>Fable now has four CursorBench effort points.</strong> Max scores highest at 70.5%, while Medium is substantially cheaper at $6.80/task. That trade-off remains visible even when another model is Pareto-optimal on a different benchmark.</div>
  </section>

  <section class="section">
    <div class="section-heading"><div><p class="section-kicker">Model-level economics</p><h2>Intelligence, normalized price density, and speed</h2></div><p>The 7:2:1 blend weights 70% cache reads, 20% fresh input and 10% output. It is a consistent cost-density convention, not a prediction of your workload.</p></div>
    <div class="panel"><div class="table-shell"><table>
      <thead><tr><th>Provider / model</th><th>Intelligence</th><th>Input/M</th><th>Cache/M</th><th>Output/M</th><th>7:2:1 blend/M</th><th>$/M/intelligence point</th><th>Output speed</th><th>Context</th><th>Evidence</th></tr></thead>
      <tbody>{modelRows.map((row) => { const source = sourceMap.get(row.sourceId); return (
        <tr>
          <td><strong>{row.model}</strong><span class="cell-sub">{row.provider} · {row.effort || row.version}</span></td>
          <td class="numeric"><strong>{row.score}</strong></td>
          <td class="numeric">{row.inputPricePerMUsd != null ? `$${row.inputPricePerMUsd.toFixed(3)}` : '—'}</td>
          <td class="numeric">{row.cachedInputPricePerMUsd != null ? `$${row.cachedInputPricePerMUsd.toFixed(3)}` : '—'}</td>
          <td class="numeric">{row.outputPricePerMUsd != null ? `$${row.outputPricePerMUsd.toFixed(3)}` : '—'}</td>
          <td class="numeric">{row.blendedPricePerMUsd > 0 ? `$${row.blendedPricePerMUsd.toFixed(3)}` : '—'}</td>
          <td class="numeric">{row.blendedUsdPerIntelligencePoint > 0 ? `$${row.blendedUsdPerIntelligencePoint.toFixed(5)}` : '—'}</td>
          <td class="numeric">{row.outputTokensPerSecond != null ? `${row.outputTokensPerSecond.toFixed(1)} t/s` : '—'}</td>
          <td class="numeric">{row.contextWindowK ? `${row.contextWindowK}K` : '—'}</td>
          <td>{source ? <a href={source.url} target="_blank" rel="noreferrer">{source.publisher}</a> : row.sourceId}</td>
        </tr>
      ); })}</tbody>
    </table></div></div>
  </section>

  <section class="section">
    <div class="section-heading"><div><p class="section-kicker">Separate benchmark</p><h2>Terminal-Bench 2.1</h2></div><p>These pass rates remain separate from the Coding Agent Index and model Intelligence Index.</p></div>
    <div class="insight-grid">{terminalRows.map((row) => <article class="insight-card"><div class="metric">{row.score}%</div><h3>{row.agent}</h3><p>{row.model} · {row.effort || 'default effort'}</p></article>)}</div>
  </section>

  <section class="section compact"><div class="callout warning"><strong>A model result is not automatically a plan result.</strong> Subscription task estimates are published only when the tested native harness, exact model route, included access mode, and a defensible allowance denominator can be joined.</div></section>
</BaseLayout>
