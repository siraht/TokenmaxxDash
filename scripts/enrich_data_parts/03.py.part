))

# BytePlus ModelArk: published model-call buckets rather than token pools.
for id_, name, price, calls5, calls7, callsm in [
    ("byteplus-modelark-lite", "Lite", 10, 1900, 12000, 24000),
    ("byteplus-modelark-pro", "Pro", 50, 9500, 60000, 120000),
]:
    upsert(make_plan(
        id=id_, provider_id="byteplus-modelark", provider="BytePlus ModelArk", name=name,
        price=price, price_display=f"${price}/mo", status="exact", confidence="high",
        allowance_type="model calls",
        headline=f"Approximately {calls5:,} model calls/5h, {calls7:,}/week and {callsm:,}/subscription month.",
        sources_=["byteplus-modelark-coding-plan-2026", "byteplus-modelark-offer-2026"],
        models=["Dola-Seed-2.0-Code", "Seed-Code", "GLM-5.1", "GLM-4.7", "DeepSeek V3.2", "GPT-OSS"],
        unit="model call", plan_units=callsm,
        quotas={"rollingFiveHourModelCallsApprox": calls5, "weeklyModelCallsApprox": calls7, "subscriptionMonthModelCallsApprox": callsm},
        formula="one provider model invocation consumes one request; a user prompt commonly triggers multiple invocations",
        value_display=f"~{callsm:,} calls/mo",
        details={"simplePromptCallsApprox": [5, 15], "complexPromptCallsApprox": [15, 30], "promptsPerMonthSimpleApprox": [math.floor(callsm/15), math.floor(callsm/5)], "promptsPerMonthComplexApprox": [math.floor(callsm/30), math.floor(callsm/15)]},
        eligibility="interactive-coding-only",
        workload_eligibility={"interactiveCoding": True, "unattendedAutomation": False, "applicationBackend": False, "note": "Plan credentials are limited to AI coding tools; use the regular ModelArk API for production services."},
    ))

