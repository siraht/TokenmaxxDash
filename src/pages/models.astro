---
import BaseLayout from '../layouts/BaseLayout.astro';
import guide from '../data/buyer-guide.json';
const models = [...guide.models].sort((a, b) => (b.intelligence ?? -1) - (a.intelligence ?? -1) || a.name.localeCompare(b.name));
const money = (value) => typeof value === 'number' ? `$${value.toFixed(value < .01 ? 5 : 3)}` : '—';
---
<BaseLayout title="Models" description="External intelligence, API token prices, coding-task evidence, and subscription-route coverage for every modeled coding LLM.">
  <section class="page-intro"><p class="eyebrow">Model evidence layer</p><h1>Compare the models before comparing the subscriptions that sell them.</h1><p class="lede">Each score remains attached to its exact external source and task harness. Subscription routes inherit only an exact model match; broad catalog labels receive no borrowed score.</p></section>
  <section class="section compact"><div class="panel"><div class="table-shell"><table>
    <thead><tr><th>Model</th><th>Provider</th><th>Intelligence</th><th>Standard API $/M</th><th>Agentic API $/M</th><th>$/M/intelligence point</th><th>Speed</th><th>Subscription routes</th><th>Task benchmark</th></tr></thead>
    <tbody>{models.map((model) => (
      <tr><td><strong>{model.name}</strong><span class="cell-sub">{model.id}</span></td><td>{model.provider}</td><td class="numeric"><span class={`score ${(model.intelligence || 0) < 50 ? 'low' : ''}`}>{model.intelligence?.toFixed(1) ?? '—'}</span></td><td class="numeric">{money(model.standardApiUsdPerM)}</td><td class="numeric">{money(model.agenticApiUsdPerM)}</td><td class="numeric">{money(model.agenticApiUsdPerMPerIntelligencePoint)}</td><td class="numeric">{model.speed != null ? `${model.speed.toFixed(1)} t/s` : '—'}</td><td class="numeric">{model.subscriptionRouteCount}</td><td>{model.taskBenchmark ? <><strong>{(model.taskBenchmark.passRate * 100).toFixed(1)}%</strong><span class="cell-sub">{model.taskBenchmark.benchmark} · {model.taskBenchmark.harness}</span></> : '—'}</td></tr>
    ))}</tbody>
  </table></div></div></section>
</BaseLayout>
