for source in OFFICIAL_SOURCES:
    add_source(source)


def by_id() -> dict[str, dict[str, Any]]:
    return {p["id"]: p for p in plans}


def remove_ids(ids: Iterable[str]) -> None:
    global plans
    wanted = set(ids)
    plans = [p for p in plans if p["id"] not in wanted]


def upsert(plan: dict[str, Any]) -> None:
    global plans
    idx = next((i for i, row in enumerate(plans) if row["id"] == plan["id"]), None)
    if idx is None:
        plans.append(plan)
    else:
        merged = deepcopy(plans[idx])
        merged.update(plan)
        plans[idx] = merged


def make_plan(
    *,
    id: str,
    provider_id: str,
    provider: str,
    name: str,
    price: float | None,
    price_display: str,
    status: str,
    confidence: str,
    allowance_type: str,
    headline: str,
    sources_: list[str],
    models: list[str],
    unit: str | None,
    plan_units: float | int | None,
    quotas: dict[str, Any],
    formula: str | None,
    value_display: str,
    value_multiple: float | None = None,
    included_value: float | None = None,
    region: str = "Global",
    currency: str = "USD",
    eligibility: str = "interactive-coding",
    details: dict[str, Any] | None = None,
    notes: list[str] | None = None,
    product_status: str = "active",
    binding_unknowns: list[str] | None = None,
    workload_eligibility: dict[str, Any] | None = None,
) -> dict[str, Any]:
    return {
        "id": id,
        "providerId": provider_id,
        "provider": provider,
        "name": name,
        "priceMonthly": price,
        "currency": currency,
        "category": "coding-subscription",
        "status": product_status,
        "region": region,
        "calculationStatus": status,
        "normalizationState": status,
        "confidence": confidence,
        "allowanceType": allowance_type,
        "headline": headline,
        "sourceIds": sources_,
        "valueMultiple": value_multiple,
        "valueMultipleLow": None,
        "valueMultipleHigh": None,
        "sortValue": value_multiple,
        "includedValueUsdMonthly": included_value,
        "formula": formula,
        "quotas": quotas,
        "models": models,
        "notes": notes or [],
        "eligibility": eligibility,
        "workloadEligibility": workload_eligibility or {
            "interactiveCoding": True,
            "unattendedAutomation": "unknown",
            "applicationBackend": "unknown",
        },
        "exactness": status,
        "unit": unit,
        "planUnits": plan_units,
        "details": details or {},
        "bindingUnknowns": binding_unknowns or [],
        "planDenominator": unit,
        "routeConfidence": "direct" if models else "catalog",
        "effectiveAt": AS_OF,
        "observedAt": AS_OF,
        "lastVerified": AS_OF,
        "priceDisplay": price_display,
        "valueDisplay": value_display,
    }


# Every legacy opaque row becomes explicitly provider-hidden unless a stronger correction below applies.
for p in plans:
    if p.get("calculationStatus") == "opaque":
        p["calculationStatus"] = "provider-hidden"
        p["exactness"] = "provider-hidden"
        p["normalizationState"] = "provider-hidden"
        p["bindingUnknowns"] = ["The provider does not publish the numerical binding allowance or deduction table."]
        p["valueDisplay"] = "Provider-hidden limit"

# Remove a tracker-only product with no verifiable primary product identity from the active catalog.
remove_ids(["ai-router-developer", "ai-router-pro", "ai-router-max"])

