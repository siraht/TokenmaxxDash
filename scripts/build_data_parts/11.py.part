        unit="category token", plan_units=float(monthly_b * Decimal("1000000000")),
    ))

# Prompt-window plans with published backend-request estimates.
for name, price, prompts, backend in [
    ("Mini", 5, 40, 600), ("Starter", 10, 100, 1500), ("Pro", 20, 300, 4500), ("Max", 50, 1000, 15000),
]:
    plans.append(make_plan(
        "StreamLake KwaiKAT", name, price, provider_id="streamlake-kwaikat", calculation_status="secondary", confidence="medium",
        allowance_type="rolling prompt quota", headline=f"{prompts:,} prompts/5h, estimated at roughly {backend:,} backend requests for the provider's average prompt.",
        sources_=["codingplans-cc"], formula="backend request estimate = prompt allowance × provider-observed subrequest expansion",
        quotas={"fiveHourPrompts": prompts, "estimatedFiveHourBackendRequests": backend}, models=["KwaiKAT coding models"],
        notes=["Prompt and backend-request counts are workload-dependent and are not token equivalents."], unit="top-level prompt", plan_units=prompts,
    ))

# Router9 credit pools lack a stable dollar conversion.
for name, price, credits, req4h, rollover in [
    ("Free", 0, 50000, 20, 0), ("Pro", 29, 500000, 500, 0.60), ("Max", 59, 1500000, 2000, 0.80),
]:
    plans.append(make_plan(
        "Router9", name, price, provider_id="router9", calculation_status="secondary", confidence="medium",
        allowance_type="monthly credits plus four-hour request window", headline=f"{credits:,} credits/month and {req4h:,} requests/4h" + (f"; {int(rollover*100)}% rollover up to 2×." if rollover else "."),
        sources_=["codingplans-cc"], formula="request consumes model-specific Router9 credits; dollar and token conversion remains unresolved",
        quotas={"monthlyCredits": credits, "fourHourRequests": req4h, "rolloverFraction": rollover, "rolloverCapMultiple": 2 if rollover else 0},
        models=["Router9 model catalog"], unit="Router9 credit", plan_units=credits,
    ))

# Cosine uses a published add-on price to value included credits.
for name, price, credits_m, addon_per_m in [
    ("Starter", 19, 4, 6.5), ("Team", 199, 47, 5), ("Enterprise", 999, 240, 4.5),
]:
    replacement = Decimal(str(credits_m)) * Decimal(str(addon_per_m))
    plans.append(make_plan(
        "Cosine", name, price, provider_id="cosine", calculation_status="exact", confidence="high",
        allowance_type="agent credits", headline=f"{credits_m:g}M credits/month; ${q(replacement)} replacement value at the published ${addon_per_m:g}/M add-on price.",
        sources_=["cosine-pricing"], value_multiple=q(replacement/Decimal(str(price)), "0.001"), included_value_usd=q(replacement),
        formula="replacement value = included credits in millions × add-on dollars per million",
        quotas={"monthlyCredits": int(credits_m * 1_000_000), "addonUsdPerMillionCredits": addon_per_m}, unit="Cosine credit", plan_units=credits_m * 1_000_000,
    ))

# Native-agent and app-builder task/credit systems.
for name, price, tasks_day, concurrent in [("Free", 0, 15, 3), ("Google AI Pro", 19.99, 100, 15), ("Google AI Ultra", 99.99, 300, 60)]:
