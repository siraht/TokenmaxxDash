{
  "name": "tokenmaxx-dash",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run prepare:data",
    "dev": "astro dev",
    "prebuild": "npm run prepare:data",
    "build": "npm run check:data && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:data": "node scripts/validate-data.mjs",
    "check:sources": "python3 scripts/check_astro_sources.py",
    "prepare:data": "npm run refresh:data && npm run sync:data",
    "sync:data": "python3 scripts/sync_public_data.py",
    "refresh:data": "python3 scripts/build_data.py && python3 scripts/complete_data.py",
    "watch:sources": "python3 scripts/watch_sources.py --write-state --save-snapshots",
    "verify": "npm run prepare:data && npm run check:data && npm run check:sources && python3 scripts/watch_sources.py --validate-only && node --check public/app.js && node --check public/community.js && python3 -m py_compile scripts/*.py"
  },
  "dependencies": {
    "astro": "7.2.2"
  },
  "devDependencies": {}
}
