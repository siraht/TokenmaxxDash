                metrics = metric_bundle(plan, model_id, cap)
                row[mix_id] = {**cap, **metrics}
            if row["standard"].get("monthlyTokensM") or row["standard"].get("monthlyRequests"):
                produced = True
                (request_rows if row["standard"].get("monthlyRequests") and not row["standard"].get("monthlyTokensM") else rows).append(row)
        if not produced:
            unquantified.append({
                "id": plan["id"], "provider": plan["provider"], "plan": plan["plan"], "priceUsd": plan["priceUsd"],
                "owned": plan["owned"], "models": [MODELS[m]["name"] for m in plan["models"] if m in MODELS],
                "allowanceKind": plan["allowance"]["kind"], "allowance": plan["allowance"],
                "confidence": plan["confidence"], "windows": plan.get("windows"), "note": plan.get("note"),
                "source": plan["source"], "policy": plan["policy"],
            })

    # Pareto helper: lower price metric is better; higher intelligence/capacity is better.
    def pareto_ids(items: list[dict[str, Any]], mix_id: str, *, min_score: float = 0, metric: str = "qualityAdjustedUsdPerM") -> list[str]:
        candidates = [r for r in items if (r.get("intelligence") or 0) >= min_score and r[mix_id].get(metric) is not None and not r["owned"]]
        keep = []
        for row in candidates:
            dominated = False
            for other in candidates:
                if other is row:
                    continue
                weak = other["priceUsd"] <= row["priceUsd"] and other["intelligence"] >= row["intelligence"] and other[mix_id][metric] <= row[mix_id][metric]
                strict = other["priceUsd"] < row["priceUsd"] or other["intelligence"] > row["intelligence"] or other[mix_id][metric] < row[mix_id][metric]
                if weak and strict:
                    dominated = True
                    break
            if not dominated:
                keep.append(row["id"])
        return keep

    frontiers = {
        mix_id: {
            "all": pareto_ids(rows, mix_id),
            "quality40": pareto_ids(rows, mix_id, min_score=40),
            "quality50": pareto_ids(rows, mix_id, min_score=50),
            "quality55": pareto_ids(rows, mix_id, min_score=55),
        } for mix_id in MIXES
    }

    # A direct shopping shortlist for the user's actual purchase decision. Bands do
    # not overlap, and providers are kept distinct where possible so the cards surface
    # alternatives rather than repeating the cheapest Command tier five times.
    PRIMARY_CONFIDENCE = {"official", "derived", "official-partial", "measured"}
    SHORTLIST_DEFINITIONS = [
        {"id": "micro", "label": "Best $1 useful-model add-on", "minPrice": 0, "maxPrice": 2, "minScore": 50, "provider": "Command Code", "plan": "Go", "sort": "value"},
        {"id": "broad", "label": "Most capable tokens for $10", "minPrice": 5, "maxPrice": 12, "minScore": 50, "provider": "OpenCode Go", "sort": "value"},
        {"id": "frontier", "label": "Highest-quality $10 route", "minPrice": 5, "maxPrice": 12, "minScore": 55, "provider": "Command Code", "plan": "GOAT", "sort": "intelligence"},
        {"id": "mainstream", "label": "Simple portable $20 pool", "minPrice": 13, "maxPrice": 25, "minScore": 50, "provider": "Kilo Pass", "sort": "value"},
        {"id": "fixed", "label": "Large fixed raw-token block", "minPrice": 26, "maxPrice": 60, "minScore": 50, "provider": "Regolo", "sort": "value"},
        {"id": "strongest", "label": "Strongest model access ≤$50", "minPrice": 0, "maxPrice": 50, "minScore": 55, "sort": "intelligence"},
    ]

    def shortlist_cards(mix_id: str) -> dict[str, list[str]]:
        used_providers: set[str] = set()
        result: dict[str, list[str]] = {}
        for definition in SHORTLIST_DEFINITIONS:
            candidates = [
                row for row in rows
                if not row["owned"]
                and row["confidence"] in PRIMARY_CONFIDENCE
                and definition["minPrice"] <= row["priceUsd"] <= definition["maxPrice"]
                and (row.get("intelligence") or 0) >= definition["minScore"]
                and row[mix_id].get("qualityAdjustedUsdPerM") is not None
                and (not definition.get("provider") or row["provider"] == definition["provider"])
                and (not definition.get("plan") or row["plan"] == definition["plan"])
            ]
            if definition.get("sort") == "intelligence":
                candidates.sort(key=lambda row: (
                    -row["intelligence"],
                    row["priceUsd"],
                    row[mix_id]["qualityAdjustedUsdPerM"],
                ))
            else:
                candidates.sort(key=lambda row: (
                    row[mix_id]["qualityAdjustedUsdPerM"],
                    -(row.get("codingScore") or -1),
                    -row["intelligence"],
                    row["priceUsd"],
                ))
            distinct = [row for row in candidates if row["provider"] not in used_providers]
            selected = (distinct or candidates)[:1]
            result[definition["id"]] = [row["id"] for row in selected]
            if selected:
                used_providers.add(selected[0]["provider"])
        return result

    shortlists = {mix_id: shortlist_cards(mix_id) for mix_id in MIXES}

    # Stable ordering for deterministic diffs.
    rows.sort(key=lambda r: (r["provider"].lower(), r["priceUsd"], -(r.get("intelligence") or -1), r["model"]))
    request_rows.sort(key=lambda r: (r["provider"].lower(), r["priceUsd"], -(r.get("intelligence") or -1)))
    unquantified.sort(key=lambda r: (r["provider"].lower(), r["priceUsd"], r["plan"]))
    models = []
    for model_id, model in MODELS.items():
        m = {"id": model_id, **model}
        for mix_id, mix in MIXES.items():
            rate = blend_rate(model, mix)
            m[f"{mix_id}ApiUsdPerM"] = rate
            if rate and model.get("intelligence"):
