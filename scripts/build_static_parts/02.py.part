    benchmark_by_id = {row["id"]: row for row in benchmarks}
    cost_frontier = [benchmark_by_id[row_id] for row_id in leaders["codingAgentCostQualityPareto"] if row_id in benchmark_by_id][:8]
    ranked_rows = "".join(f'''<tr><td><a href="/plans/{p['id']}/"><strong>{e(p['provider'])} · {e(p['name'])}</strong></a><span class="cell-sub">{e(p['region'])}</span></td><td class="numeric">{e(p['priceDisplay'])}</td><td class="numeric"><strong>{e(p['valueDisplay'])}</strong></td><td>{badge(p['calculationStatus'])}</td><td>{e(p['headline'])}</td></tr>''' for p in ranked)
    frontier_rows = "".join(f'''<tr><td><strong>{e(row['agent'])}</strong><span class="cell-sub">{e(row['model'])}</span></td><td class="numeric">{fmt(row['score'])}</td><td class="numeric">${fmt(row.get('apiCostPerTaskUsd'),3)}</td><td class="numeric">${fmt(row.get('apiUsdPerExpectedPass'),4)}</td><td><span class="pareto-chip">non-dominated</span><span class="cell-sub">No imported configuration is both at least as capable and no more expensive.</span></td></tr>''' for row in cost_frontier)
    body = f'''
<section class="hero"><div><p class="eyebrow">Coding-plan economics, quality included</p><h1>Compare subscriptions by the constraint that actually matters.</h1><p class="lede">Token subsidy, model intelligence, coding-agent success, time, and provider-hidden quotas answer different questions. Tokenmaxx exposes non-dominated choices instead of declaring the best-researched plan the universal winner.</p><div class="hero-actions"><a class="button primary" href="/leaders/">Explore Pareto leaders</a><a class="button" href="/plans/">Search all plans</a><a class="button subtle" href="/benchmarks/">Inspect external benchmarks</a></div></div><aside class="verdict-card"><p class="section-kicker">Current market verdict</p><strong>No single winner</strong><span>StepFun leads transparent subsidy; Codex leads measured frontier subsidy.</span><p>The quality-adjusted frontier changes again once externally measured intelligence, task success, API cost, and speed are applied.</p></aside></section>
<section class="section compact"><div class="kpi-grid"><article class="kpi-card"><strong>{summary['planCount']}</strong><span>active and historical plan tiers</span></article><article class="kpi-card"><strong>{summary['modelRouteCount']}</strong><span>advertised model routes covered</span></article><article class="kpi-card"><strong>{summary['directBenchmarkModelRouteCount']}</strong><span>routes with a direct external signal</span></article><article class="kpi-card"><strong>{summary['providerHiddenCount']}</strong><span>provider-hidden pools, explicitly labeled</span></article></div></section>
<section class="section"><div class="section-heading"><div><p class="section-kicker">Different objectives, different leaders</p><h2>The comparison is a Pareto surface.</h2></div><p>A plan belongs on a frontier when no alternative is at least as capable and also cheaper, faster, or more generous on the selected denominator.</p></div><div class="insight-grid">{insight_card(f"{summary['topNormalizedValue']['multiple']}×",'Transparent nominal subsidy',f"{summary['topNormalizedValue']['label']} leads the quantified recurring-price multiple, but this says nothing about the intelligence of the models bought with that pool.")}{insight_card(f"{summary['topMeasuredFrontierSubsidy']['multiple']}×",'Measured frontier subsidy','Codex Pro 20× leads the cleanly measured frontier-subscription API-equivalent evidence, not the entire market under every quality and latency requirement.','blue')}{insight_card(f"{len(cost_frontier)} non-dominated",'Coding-agent cost versus quality','The imported Coding Agent Index forms a ladder from maximum-effort frontier models through smaller low-cost configurations rather than one scalar champion.','warning')}</div></section>
<section class="section"><div class="section-heading"><div><p class="section-kicker">Subscription subsidy</p><h2>Highest quantified recurring-price multiples</h2></div><p>Each value retains its denominator and therefore measures economic subsidy rather than intelligence.</p></div><div class="panel"><div class="table-shell"><table><thead><tr><th>Plan</th><th>Price</th><th>Quantified value</th><th>Evidence</th><th>Allowance</th></tr></thead><tbody>{ranked_rows}</tbody></table></div></div></section>
<section class="section"><div class="section-heading"><div><p class="section-kicker">External task economics</p><h2>Coding-agent cost–quality frontier</h2></div><a class="button subtle" href="/leaders/">See every frontier</a></div><div class="panel"><div class="table-shell"><table><thead><tr><th>Agent / model</th><th>Index</th><th>API cost/task</th><th>API $/expected pass</th><th>Why it remains</th></tr></thead><tbody>{frontier_rows}</tbody></table></div></div></section>
<section class="section compact"><div class="callout warning"><strong>Provider-hidden is a completed finding, not a blank cell.</strong> Where a vendor publishes mechanics but withholds the numerical pool, the record states exactly what remains unknowable and excludes the plan from allowance rankings.</div></section>'''
    write_page("/", layout("Tokenmaxx", body, "/"))


def build_plans() -> None:
    providers = sorted({p["provider"] for p in plans})
    ordered = sorted(plans, key=lambda p: p.get("sortValue") if p.get("sortValue") is not None else -1, reverse=True)
    options = "".join(f'<option value="{e(provider)}">{e(provider)}</option>' for provider in providers)
    rows = "".join(plan_row(plan) for plan in ordered)
    body = f'''<section class="page-intro"><p class="eyebrow">{summary['planCount']} tiers · {summary['providerCount']} providers</p><h1>Every plan, including provider-hidden and unmatched products.</h1><p class="lede">Exact plans expose their published unit and formula. Derived plans combine official rates with reproducible measurements. Partial, measured-range, provider-hidden, and secondary records remain visible without receiving invented economics.</p></section>
<section class="section compact"><div class="toolbar"><div class="control"><label for="plan-search">Search</label><input id="plan-search" data-filter-search type="search" placeholder="Provider, tier, model or quota…"></div><div class="control"><label for="plan-status">Evidence</label><select id="plan-status" data-filter-status><option value="all">All evidence</option><option value="exact">Official exact</option><option value="derived">Evidence-derived</option><option value="measured-range">Measured range</option><option value="partial">Partially normalized</option><option value="provider-hidden">Provider-hidden</option><option value="secondary">Secondary-source</option><option value="legacy">Legacy</option></select></div><div class="control"><label for="plan-provider">Provider</label><select id="plan-provider" data-filter-provider><option value="all">All providers</option>{options}</select></div><div class="control"><label for="plan-sort">Sort</label><select id="plan-sort" data-sort-plans><option value="value-desc">Quantified value</option><option value="price-asc">Price: low to high</option><option value="price-desc">Price: high to low</option><option value="provider">Provider</option></select></div></div><p class="results-count" data-results-count>{len(plans)} plan tiers</p><div class="panel"><div class="table-shell"><table data-plan-table><thead><tr><th>Provider / plan</th><th>Price</th><th>Value / unit</th><th>Evidence</th><th>Allowance</th><th>Region</th></tr></thead><tbody>{rows}</tbody></table></div><div class="empty-state" data-empty-state>No plan matches those filters.</div></div></section>'''
